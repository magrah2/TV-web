# Nastavení serveru pro ostrý web. Leží v `public/`, takže ho Astro zkopíruje
# do `dist/` a nasazení ho nahraje s webem. Souvislosti jsou v README.

# Stojí schválně první: kdyby server o kus níž zakopl a přestal soubor číst,
# tahle direktiva už platí.
ErrorDocument 404 /404.html

# HTML se musí pokaždé ověřit, protože se jmenuje pořád stejně. Soubory
# z `_astro/` mají v názvu otisk obsahu, takže stejné jméno znamená stejný
# obsah a smí ležet rok. Vzor míří na ten otisk před příponou, protože
# `FilesMatch` vidí jméno souboru, ne cestu — soubory z `public/` se ho tedy
# netýkají, a správně.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.[A-Za-z0-9_-]{8,}\.(css|js|webp|avif|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# DOČASNÉ, po vyřešení 404 smazat: ověřuje, že server tenhle soubor vůbec čte.
Redirect 302 /zkouska-htaccess /
