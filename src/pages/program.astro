---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import { BARVA_TEMATU } from '../lib/temata';
import { odkaz } from '../lib/odkaz';
import type { Tema } from '../lib/temata';

const oblasti = (await getCollection('program')).sort((a, b) => a.data.poradi - b.data.poradi);

// Podrobný rozpis nemá každá oblast — odkaz „Chci vědět víc" se proto ukáže
// jen tam, kde k němu opravdu něco je.
const detaily = await getCollection('programDetail');
const detailOblasti = new Map(detaily.map((d) => [d.data.oblast, d.id]));

// Překlep v `oblast` by odkaz potichu nevykreslil a nikdo by si toho nevšiml.
// Radši to shodíme tady, při sestavení.
const nezname = detaily.filter((d) => !oblasti.some((o) => o.id === d.data.oblast));
if (nezname.length) {
  throw new Error(
    'Podrobný program ukazuje na oblasti, které neexistují: ' +
      nezname.map((d) => `${d.id}.md → „${d.data.oblast}"`).join(', ') +
      '. Do `oblast:` patří název souboru oblasti ze `src/content/program` bez přípony.',
  );
}

const sObsahem = await Promise.all(
  oblasti.map(async (oblast) => ({
    ...oblast,
    Obsah: (await render(oblast)).Content,
    detail: detailOblasti.get(oblast.id) ?? null,
  })),
);
---

<Zaklad
  titulek="Náš program"
  popis="Osm oblastí, ve kterých chceme Vyškov změnit: transparentní správa, dostupné bydlení, zeleň a voda, podnikání, školství, bezpečnost, kultura a bezpečný pohyb."
>
  <div class="pruh">
    <p class="nadtitulek">Náš program</p>
    <h1 class="nadpis">Co chceme ve Vyškově změnit</h1>
    <p class="perex uvod">
      Osm oblastí, ve kterých chceme Vyškov posunout. Hodně z toho jsou věci,
      které jinde fungují dobře.
    </p>

    <ol class="oblasti">
      {
        sObsahem.map((oblast) => (
          <li class="oblast" id={`oblast-${oblast.data.poradi}`}>
            <div class="oblast-hlava">
              <span
                class="oblast-cislo"
                style={`--barva: ${BARVA_TEMATU[oblast.data.tema as Tema]}`}
                aria-hidden="true"
              >
                {String(oblast.data.poradi).padStart(2, '0')}
              </span>
              <div>
                <h2>{oblast.data.nadpis ?? oblast.data.nazev}</h2>
                <p class="oblast-shrnuti">{oblast.data.shrnuti}</p>
              </div>
            </div>
            <div class="oblast-obsah">
              <oblast.Obsah />
              {
                oblast.detail && (
                  <p class="oblast-vic">
                    <a href={odkaz(`/program/${oblast.detail}/`)}>
                      Chci vědět víc <span aria-hidden="true">→</span>
                      <span class="jen-pro-ctecky"> o oblasti {oblast.data.nazev}</span>
                    </a>
                  </p>
                )
              }
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Zaklad>

<style>
  .nadpis {
    max-width: 20ch;
  }

  .uvod {
    margin-top: 1rem;
  }

  .oblasti {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .oblast {
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--linka);
    scroll-margin-top: 6rem;
  }

  .oblast:last-child {
    border-bottom: 1px solid var(--linka);
  }

  .oblast-hlava {
    display: flex;
    align-items: start;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }

  /* Číslo v barvě programové oblasti — stejný odstín pak ponese
     příslušný bod na mapě záměrů, takže se to spojí i vizuálně. */
  .oblast-cislo {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--barva) 14%, transparent);
    color: var(--barva);
    font-size: var(--text-maly);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .oblast-shrnuti {
    max-width: 48ch;
    margin: 0.45rem 0 0;
    font-size: var(--text-maly);
    color: var(--inkoust-tlum);
  }

  .oblast-vic {
    margin: 1.1rem 0 0;
  }

  .oblast-vic a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-maly);
    font-weight: 600;
    color: var(--modra-text);
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--modra) 35%, transparent);
    padding-bottom: 0.1rem;
    transition: border-color var(--prechod);
  }

  .oblast-vic a:hover {
    border-bottom-color: var(--modra);
  }

  .oblast-obsah {
    max-width: var(--sirka-textu);
    margin-top: 1.1rem;
    margin-left: calc(2.75rem + clamp(0.9rem, 2vw, 1.5rem));
  }

  .oblast-obsah :global(ul) {
    margin: 0;
    padding-left: 1.15em;
  }

  .oblast-obsah :global(li) {
    margin-bottom: 0.5em;
  }

  .oblast-obsah :global(li)::marker {
    color: var(--zelena);
  }

  @media (max-width: 560px) {
    .oblast-obsah {
      margin-left: 0;
    }
  }
</style>
