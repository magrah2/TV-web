---
/**
 * Vyhledávač volební místnosti.
 *
 * Člověk napíše svoji adresu a web mu řekne, do kterého okrsku patří, kde
 * volí a kdy má otevřeno — a ukáže mu to na mapě.
 *
 * Data o okrscích jsou z otevřených dat ČÚZK (RÚIAN), kde je ke každé adrese
 * v obci uvedené číslo volebního okrsku; vymezení tam zapisuje starosta.
 * Seznam volebních místností je přepsaný z úřední vyhlášky města, protože ten
 * v otevřených datech není. Obojí vyrábí `nastroje/okrsky.mjs`.
 *
 * Adresy se NEVKLÁDAJÍ do stránky — je jich skoro šest tisíc a HTML by
 * nabobtnalo. Načtou se až ve chvíli, kdy člověk začne psát.
 */

import fs from 'node:fs';
import { VOLEBNI_MISTNOSTI, VOLEBNI_DNY, SOUBEZNE_VOLBY } from '../lib/volebni-mistnosti';
import { odkaz } from '../lib/odkaz';
import podkladObec from '../../public/mapa-obec.svg?raw';
import plochyOkrsku from '../../public/mapa-okrsky.svg?raw';
import vyrez from '../lib/mapa-vyrez-obec.json';

// --- Souřadnice volebních místností ---------------------------------------
// Vyhláška uvádí jen adresu. Souřadnice se dohledají v datech ČÚZK, takže se
// nikde neopisují ručně. Když se místnost nenajde, sestavení spadne — to je
// lepší než pin, který na mapě chybí a nikdo si toho nevšimne.

interface Adresa {
  ulice: string;
  cislo: string;
  lat: number;
  lon: number;
}

const data = JSON.parse(fs.readFileSync('public/data/okrsky.json', 'utf8')) as {
  ulice: string[];
  adresy: [number, string, number, number, number, number][];
};

const zjednodus = (t: string) =>
  t.normalize('NFD').replace(/\p{Mn}/gu, '').toLowerCase().replace(/\s+/g, ' ').trim();

const vsechnyAdresy: Adresa[] = data.adresy.map((a) => ({
  ulice: data.ulice[a[0]],
  cislo: a[1],
  lat: a[3],
  lon: a[4],
}));

function najdiAdresu(popis: string): Adresa {
  // „Dědická 104/130" — v datech je zvlášť číslo popisné a orientační,
  // takže zkusíme obě části zvlášť.
  const shoda = popis.match(/^(.*?)\s+(\S+)$/);
  if (!shoda) throw new Error(`Adresu volební místnosti "${popis}" neumím rozebrat.`);
  const [, ulice, cislaText] = shoda;
  const cisla = cislaText.split('/');
  const uliceKlic = zjednodus(ulice);

  for (const cislo of [...cisla].reverse()) {
    const nalez = vsechnyAdresy.find(
      (a) => zjednodus(a.ulice) === uliceKlic && zjednodus(a.cislo) === zjednodus(cislo),
    );
    if (nalez) return nalez;
  }
  throw new Error(
    `Volební místnost "${popis}" jsem v datech ČÚZK nenašel. ` +
      `Zkontrolujte adresu v src/lib/volebni-mistnosti.ts.`,
  );
}

// Mercator — stejná projekce jako u generátoru mapy
const merkator = (lat: number) => Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 180 / 2));
const yJih = merkator(vyrez.jih);
const MERITKO = vyrez.sirka / (vyrez.vychod - vyrez.zapad);
const naMapu = (lat: number, lon: number) => ({
  x: +(((lon - vyrez.zapad) * MERITKO * 100) / vyrez.sirka).toFixed(2),
  y: +(((vyrez.vyska - (merkator(lat) - yJih) * (180 / Math.PI) * MERITKO) * 100) / vyrez.vyska).toFixed(2),
});

const mistnosti = VOLEBNI_MISTNOSTI.map((m) => {
  const adresa = najdiAdresu(m.adresa);
  return { ...m, ...naMapu(adresa.lat, adresa.lon) };
});

/** Několik místností slouží víc okrskům — na mapě chceme jeden pin, ne pět. */
const piny = [...new Map(mistnosti.map((m) => [`${m.x},${m.y}`, m])).values()];

const mistnostiProSkript = Object.fromEntries(
  mistnosti.map((m) => [m.okrsek, { nazev: m.nazev, adresa: m.adresa, bezbarierovy: m.bezbarierovy, poznamka: m.poznamka ?? null, x: m.x, y: m.y }]),
);
---

<section class="kde-volit pas-noc" id="kde-volit">
  <div class="pruh">
    <p class="nadtitulek">Kde volit</p>
    <h2 class="kde-nadpis">Napište adresu a řekneme vám, kam máte jít</h2>
    <p class="perex kde-perex">
      Vyškov má 26 volebních okrsků a volební místnost se řídí tím, kde máte trvalý pobyt.
      Stačí začít psát ulici.
    </p>

    {/* Bez JavaScriptu vyhledávač nefunguje, takže je schovaný a odkrývá ho až
        skript. Pod ním zůstává úplný seznam místností, který stačí sám o sobě. */}
    <form class="hledani" data-hledani hidden autocomplete="off">
      <label class="hledani-popisek" for="adresa">Vaše adresa ve Vyškově</label>
      <div class="hledani-pole">
        <input
          type="text"
          id="adresa"
          name="adresa"
          placeholder="například Dukelská 12"
          role="combobox"
          aria-expanded="false"
          aria-controls="navrhy"
          aria-autocomplete="list"
          data-vstup
        />
        <button type="button" class="hledani-smazat" data-smazat hidden aria-label="Smazat">×</button>
      </div>
      <ul class="navrhy" id="navrhy" role="listbox" data-navrhy hidden></ul>
      <p class="hledani-stav" data-stav aria-live="polite"></p>
    </form>

    <div class="vysledek" data-vysledek hidden></div>

    <div class="kde-rozvrzeni">
      {/* ---------- Mapa ---------- */}
      <div class="mapa-obal">
        <div class="mapa-plocha" data-mapa>
          <div class="mapa-vnitrek" data-mapa-vnitrek>
            <Fragment set:html={podkladObec} />
            <div class="vrstva-okrsku" set:html={plochyOkrsku} />

            <div class="mapa-body">
              {
                piny.map((m) => (
                  <span
                    class="mistnost-pin"
                    data-pin-okrsek={m.okrsek}
                    style={`left: ${m.x}%; top: ${m.y}%`}
                    title={`${m.nazev}, ${m.adresa}`}
                  />
                ))
              }
              <span class="moje-adresa" data-moje hidden></span>
            </div>
          </div>

          <div class="mapa-ovladani" data-mapa-ovladani hidden>
            <button type="button" data-zoom="ven" aria-label="Oddálit mapu">−</button>
            <button type="button" data-zoom="dovnitr" aria-label="Přiblížit mapu">+</button>
            <button type="button" data-zoom="reset" aria-label="Zobrazit celou obec">Celá obec</button>
          </div>
        </div>

        <p class="mapa-zdroj">
          Okrsky: data&nbsp;© ČÚZK (RÚIAN), CC&nbsp;BY&nbsp;4.0 · podklad: data&nbsp;©&nbsp;přispěvatelé OpenStreetMap
        </p>
      </div>

      {/* ---------- Kdy a seznam ---------- */}
      <div class="kde-vedle">
        <div class="kdy">
          <h3>Kdy se volí</h3>
          <ul>
            {
              VOLEBNI_DNY.map((d) => (
                <li>
                  <strong>{d.den}</strong> {d.datum}
                  <span class="kdy-cas">{d.od}–{d.do}</span>
                </li>
              ))
            }
          </ul>
          <p class="kdy-pozn">
            Ve stejném termínu se volí i do {SOUBEZNE_VOLBY.nazev}. Dostanete tedy dvě sady
            lístků — druhé kolo senátních voleb je {SOUBEZNE_VOLBY.druheKolo.od} a {SOUBEZNE_VOLBY.druheKolo.do}.
          </p>
        </div>

        <details class="seznam">
          <summary>Seznam všech 26 volebních místností</summary>
          <ol>
            {
              VOLEBNI_MISTNOSTI.map((m) => (
                <li>
                  <span class="seznam-okrsek">{m.okrsek}</span>
                  <span>
                    <strong>{m.nazev}</strong>, {m.adresa}
                    {m.bezbarierovy && <span class="znacka-bezbarierovy" title="Bezbariérový přístup">♿</span>}
                  </span>
                </li>
              ))
            }
          </ol>
        </details>
      </div>
    </div>

    <p class="kde-uredni">
      Údaje vycházejí z úřední vyhlášky města Vyškova a z otevřených dat ČÚZK. Kdyby něco
      nesedělo, rozhoduje vyhláška — a napište nám, opravíme to.
    </p>
  </div>
</section>

<style>
  .kde-volit {
    padding-block: var(--mezera-sekce);
  }

  .kde-nadpis {
