---
/**
 * Kde volit — mapa volebních budov a vyhledávač adresy.
 *
 * Dvě cesty ke stejné odpovědi: buď člověk napíše adresu, nebo si klikne
 * do mapy na svoje okolí. Obojí vede na stejnou kartu s volební místností.
 *
 * Mapa je rozdělená podle BUDOV, ne podle okrsků. Voliče nezajímá číslo
 * okrsku, ale do které budovy má jít — a když několik okrsků volí na stejném
 * místě, jsou to z jeho pohledu jedna oblast.
 *
 * Podklad je tentýž jako u mapy záměrů a u stánku (`src/lib/mapa-zaklad.ts`).
 * Plochy oblastí se na něj kladou jako vlastní vrstva, ještě pod ulice —
 * kdyby ležely nahoře, překryly by silnice i řeku a z mapy by byla mazanice.
 *
 * Data o okrscích jsou z otevřených dat ČÚZK (RÚIAN), kde je ke každé adrese
 * v obci uvedené číslo volebního okrsku; vymezení tam zapisuje starosta.
 * Seznam volebních místností je přepsaný z úřední vyhlášky města, protože ten
 * v otevřených datech není. Obojí připravuje `nastroje/okrsky.mjs`.
 *
 * Adresy se NEVKLÁDAJÍ do stránky — je jich skoro šest tisíc a HTML by
 * nabobtnalo. Načtou se až ve chvíli, kdy je člověk potřebuje.
 */

import fs from 'node:fs';
import { Image } from 'astro:assets';
import { VOLEBNI_DNY, SOUBEZNE_VOLBY } from '../lib/volebni-mistnosti';
import { odkaz } from '../lib/odkaz';
import { BARVY_OBLASTI, BARVA_VYBRANE_OBLASTI } from '../lib/styl-mapy';
import nahledMapy from '../assets/nahled-mapa-okrsku.png';
import '../styles/mapa.css';

// --- Data ------------------------------------------------------------------

const data = JSON.parse(fs.readFileSync('public/data/okrsky.json', 'utf8')) as {
  ulice: string[];
  casti: string[];
  budovy: { nazev: string; adresa: string; bezbarierovy: boolean; okrsky: number[]; barva: number }[];
  okrsekNaBudovu: Record<string, number>;
  adresy: [number, string, string, number, number, number, number][];
};

const zjednodus = (t: string) =>
  t.normalize('NFD').replace(/\p{Mn}/gu, '').toLowerCase().replace(/\s+/g, ' ').trim();

const vsechnyAdresy = data.adresy.map((a) => ({
  ulice: data.ulice[a[0]],
  co: a[1],
  cp: a[2],
  lat: a[4],
  lon: a[5],
}));

/** Dohledá souřadnice volební místnosti podle její adresy z vyhlášky. */
function najdiAdresu(popis: string) {
  // „Slovanská 111, Hamiltony" — část za čárkou je upřesnění, ne adresa.
  const shoda = popis.split(',')[0].trim().match(/^(.*?)\s+(\S+)$/);
  if (!shoda) throw new Error(`Adresu volební místnosti "${popis}" neumím rozebrat.`);
  const [, ulice, cislaText] = shoda;
  const uliceKlic = zjednodus(ulice);
  // „Dědická 104/130" — v datech je zvlášť číslo popisné a orientační.
  const cisla = cislaText.split('/').map(zjednodus);

  // Vyhláška píše adresy tak, jak jsou na domech — tedy číslem orientačním.
  // Hledá se proto NEJDŘÍV podle něj a teprve pak podle popisného. Bez toho
  // pořadí by „Slovanská 111" mohla trefit dům o dvě stě metrů vedle,
  // protože stejné číslo existuje v obou řadách.
  for (const podle of ['co', 'cp'] as const) {
    for (const c of cisla) {
      const nalez = vsechnyAdresy.find(
        (a) => zjednodus(a.ulice) === uliceKlic && zjednodus(a[podle]) === c,
      );
      if (nalez) return nalez;
    }
  }
  throw new Error(
    `Volební místnost "${popis}" jsem v datech ČÚZK nenašel. ` +
      `Zkontrolujte adresu v src/lib/volebni-mistnosti.json.`,
  );
}

// Poloha budov je zeměpisná, ne v jednotkách mapy. Mapa se dá posouvat
// a přibližovat, takže souřadnice pevné k jednomu výřezu by byly k ničemu.
const budovy = data.budovy.map((b) => {
  const adresa = najdiAdresu(b.adresa);
  return { ...b, lat: adresa.lat, lon: adresa.lon };
});

// --- Obydlená plocha -------------------------------------------------------
// Stažená mapa zabírá celé katastrální území včetně polí a lesů, kde nikdo
// nebydlí. Kdyby se výchozí pohled řídil jím, obec by se scvrkla doprostřed.
// Pohled se proto řídí rozsahem adres — vidět je pořád všechno až po
// Rychtářov, ale vyplní to rám.
const zemepisneSirky = data.adresy.map((a) => a[4]);
const zemepisneDelky = data.adresy.map((a) => a[5]);
const obydlene: [[number, number], [number, number]] = [
  [Math.min(...zemepisneDelky), Math.min(...zemepisneSirky)],
  [Math.max(...zemepisneDelky), Math.max(...zemepisneSirky)],
];

/**
 * Co potřebuje skript v prohlížeči.
 *
 * Předává se jako JSON v samostatné značce, ne přes `define:vars`. Ten by
 * ze skriptu udělal vložený kód, do kterého nejde nic importovat — a mapa
 * potřebuje knihovnu MapLibre.
 */
const proSkript = {
  cestaKDatum: odkaz('/data/okrsky.json'),
  cestaKPlocham: odkaz('/data/okrsky-plochy.json'),
  budovy,
  obydlene,
  barvyOblasti: BARVY_OBLASTI,
  barvaVybrane: BARVA_VYBRANE_OBLASTI,
};
---

<section class="kde-volit pas-noc" id="kde-volit">
  <div class="pruh">
    <p class="nadtitulek">Kde volit</p>
    <h2 class="kde-nadpis">Napište adresu, nebo si klikněte do&nbsp;mapy</h2>
    <p class="perex kde-perex">
      Volební místnost se řídí tím, kde máte trvalý pobyt. Každá barva na mapě je jedna
      budova, do které se v jejím okolí chodí volit.
    </p>

    <div class="kde-ovladaci">
      {/* Bez JavaScriptu vyhledávač nefunguje, takže je schovaný a odkrývá ho
          až skript. Mapa a časy zůstanou čitelné tak jako tak. */}
      <form class="hledani" data-hledani hidden autocomplete="off">
        <label class="hledani-popisek" for="adresa">Vaše adresa ve Vyškově</label>
        <div class="hledani-pole">
          <input
            type="text"
            id="adresa"
            name="adresa"
            placeholder="například Dukelská 12"
            role="combobox"
            aria-expanded="false"
            aria-controls="navrhy"
            aria-autocomplete="list"
            data-vstup
          />
          <button type="button" class="hledani-smazat" data-smazat hidden aria-label="Smazat">×</button>
        </div>
        <ul class="navrhy" id="navrhy" role="listbox" data-navrhy hidden></ul>
        <p class="hledani-stav" data-stav aria-live="polite"></p>
      </form>

      <div class="karta" data-karta>
        <p class="karta-vyzva" data-vyzva>
          Klikněte na barevnou plochu v mapě, nebo si najděte svoji adresu.
        </p>
        <div class="karta-obsah" data-karta-obsah hidden aria-live="polite"></div>
      </div>
    </div>

    {/* ---------- Mapa ---------- */}
    <div class="mapa-plocha" data-mapa>
      <div class="mapa-platno" data-mapa-platno></div>

      {/* Značky vykresluje šablona, ne skript. Obal kolem každé z nich musí
          být: mapa značce nastavuje `transform`, kterým ji drží na místě,
          a vlastní posun nebo zvětšení uvnitř by jí ho přepsaly. */}
      <div class="mapa-znacky" data-mapa-znacky hidden>
        {
          budovy.map((b, i) => (
            <span class="znacka" data-pin-budova={i} data-lat={b.lat} data-lon={b.lon}>
              <button
                type="button"
                class="budova-pin"
                aria-label={`Volební místnost ${b.nazev}, ${b.adresa}`}
                title={`${b.nazev}, ${b.adresa}`}
              />
            </span>
          ))
        }

        <span class="znacka" data-moje hidden><span class="moje-adresa" /></span>

        {/* Popisky se doplňují až po výběru — do té doby by jen zabíraly místo. */}
        <span class="znacka" data-popis-adresy hidden><span class="popis-mapy popis-adresy" /></span>
        <span class="znacka" data-popis-cile hidden><span class="popis-mapy popis-cile" /></span>
      </div>

      <div class="mapa-ovladani" data-mapa-ovladani hidden>
        <button type="button" data-zoom="ven" aria-label="Oddálit mapu">−</button>
        <button type="button" data-zoom="dovnitr" aria-label="Přiblížit mapu">+</button>
        <button type="button" data-zoom="reset" aria-label="Zobrazit celou obec">Celá obec</button>
      </div>

      <noscript>
        <Image
          src={nahledMapy}
          alt="Mapa Vyškova rozdělená na oblasti podle volebních místností"
          class="mapa-nahrada"
        />
        <p class="mapa-bez-js">
          Mapa se ovládá skriptem, který je vypnutý. Seznam všech volebních místností
          i s adresami najdete níž.
        </p>
      </noscript>
    </div>

    <script type="application/json" data-mapa-data set:html={JSON.stringify(proSkript)} />


    <div class="pod-mapou">
      <p class="mapa-zdroj">
        Okrsky: data&nbsp;© ČÚZK (RÚIAN), CC&nbsp;BY&nbsp;4.0 · podklad: data&nbsp;©&nbsp;přispěvatelé OpenStreetMap.
        Plochy jsou odvozené z adres, nejsou to úřední hranice.
      </p>

      <div class="kdy">
        <h3>Kdy se volí</h3>
        <ul>
          {
            VOLEBNI_DNY.map((d) => (
              <li>
                <strong>{d.den}</strong> {d.datum}
                <span class="kdy-cas">{d.od}–{d.do}</span>
              </li>
            ))
          }
        </ul>
        <p class="kdy-pozn">
          Ve stejném termínu se volí i do {SOUBEZNE_VOLBY.nazev}. Dostanete tedy dvě sady
          lístků — druhé kolo senátních voleb je {SOUBEZNE_VOLBY.druheKoloOd} a {SOUBEZNE_VOLBY.druheKoloDo}.
        </p>
      </div>


      {/* Seznam funguje i bez JavaScriptu, kde mapa ani vyhledávač nejedou.
          Hodí se ale i jinak: kdo svoji místnost zná jménem, najde ji tu
          rychleji než klikáním do mapy. */}
      <details class="vsechny-mistnosti">
        <summary>Seznam všech volebních místností</summary>
        <ol>
          {
            budovy.map((b) => (
              <li>
                <strong>{b.nazev}</strong>, {b.adresa}
                {b.bezbarierovy && ' ♿'}
                <span class="mistnost-okrsky">
                  {b.okrsky.length > 1 ? 'okrsky' : 'okrsek'} {b.okrsky.join(', ')}
                </span>
              </li>
            ))
          }
        </ol>
      </details>
    </div>
  </div>
</section>

<style>
  .kde-volit {
    padding-block: var(--mezera-sekce);
  }

  .kde-nadpis {
    max-width: 24ch;
  }

  .kde-perex {
    margin-top: 0.9rem;
  }

  /* ---------- Vyhledávač a karta vedle sebe ---------- */

  .kde-ovladaci {
    display: grid;
    gap: 1rem;
    align-items: start;
    /* Výška popisku nad polem pro adresu. O tolik se musí posunout i karta
       vedle, aby obě krabice začínaly na stejném řádku — jinak jedna visí
       výš než druhá a je to na první pohled vidět. Řádkování je proto
       u popisku zapsané natvrdo, ať se výpočet nemá o co rozejít. */
    --vyska-popisku: calc(var(--text-drobny) * 1.65 + 0.4rem);
    /* A výška samotného pole, aby karta vedle nebyla o kus nižší. Odvozuje
       se ze stejných hodnot, jaké pole skutečně má: řádkování, odsazení
       nahoře i dole a rámeček. */
    --vyska-pole: calc(var(--text-velky) * 1.65 + 1.6rem + 2px);
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: 1rem;
  }

  @media (min-width: 820px) {
    .kde-ovladaci {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
    }

    /* Vedle sebe začínají obě krabice na stejném řádku. Pod sebou (na úzkém
       displeji) by odsazení dělalo jen zbytečnou mezeru. */
    .karta {
      margin-top: var(--vyska-popisku);
    }
  }

  /* ---------- Hledání ---------- */

  .hledani {
    position: relative;
  }

  .hledani[hidden] {
    display: none;
  }

  .hledani-popisek {
    display: block;
    line-height: 1.65;
    margin-bottom: 0.4rem;
    font-size: var(--text-drobny);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--na-noci-tlum);
  }

  .hledani-pole {
    position: relative;
  }

  .hledani input {
    width: 100%;
    padding: 0.8rem 2.8rem 0.8rem 1rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    background: var(--noc-svetlejsi);
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-velky);
  }

  .hledani input::placeholder {
    color: var(--na-noci-tlum);
  }

  .hledani input:focus {
    border-color: #8fc4ec;
    outline: none;
  }

  .hledani-smazat {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 2rem;
    height: 2rem;
    transform: translateY(-50%);
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--na-noci-tlum);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .hledani-smazat:hover {
    color: var(--na-noci);
  }

  .navrhy {
    position: absolute;
    z-index: 8;
    left: 0;
    right: 0;
    max-height: 17rem;
    overflow-y: auto;
    margin: 0.35rem 0 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--noc-svetlejsi);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.5);
  }

  .navrhy[hidden] {
    display: none;
  }

  .navrhy li {
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-maly);
    font-size: var(--text-maly);
    cursor: pointer;
  }

  .navrhy li:hover,
  .navrhy li[data-vybrany] {
    background: rgb(255 255 255 / 0.1);
  }

  .navrh-cast {
    color: var(--na-noci-tlum);
  }

  .hledani-stav {
    margin: 0.5rem 0 0;
    font-size: var(--text-maly);
    color: var(--na-noci-tlum);
  }

  /* ---------- Karta s výsledkem ---------- */

  .karta {
    /* Vysoká podle obsahu, ne podle sloupce vedle — natažená na výšku
       vyhledávače v ní pod jedinou větou zela prázdnota. Nejmíň ale jako
       pole pro adresu, ať to vedle sebe vypadá jako dvojice. */
    display: grid;
    align-content: center;
    min-height: var(--vyska-pole);
    padding: 0.85rem 1.1rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    transition: background var(--prechod), border-color var(--prechod);
  }

  .karta[data-vybrano] {
    background: rgb(91 174 57 / 0.15);
    border-color: rgb(91 174 57 / 0.45);
  }

  .karta p {
    margin: 0;
  }

  .karta-vyzva {
    font-size: var(--text-maly);
    color: var(--na-noci-tlum);
  }

  .karta-vyzva[hidden],
  .karta-obsah[hidden] {
    display: none;
  }

  .karta-nadtitulek {
    font-size: var(--text-drobny);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9ed484;
  }

  .karta-misto {
    margin-top: 0.35rem !important;
    font-size: var(--text-nadpis-3);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--na-noci);
  }

  /* Adresa navazuje čárkou na název — „Základní škola Vyškov, Morávkova 40". */
  .karta-misto span {
    font-weight: 400;
    color: var(--na-noci-tlum);
  }

  .karta-doplnek {
    margin-top: 0.55rem !important;
    font-size: var(--text-drobny);
    color: #9ed484;
  }

  .karta-vase {
    margin-top: 0.55rem !important;
    padding-top: 0.55rem;
    border-top: 1px solid var(--linka-na-noci);
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
  }

  /* ---------- Mapa ---------- */

  .mapa-plocha {
    position: relative;
    /* Pevná výška místo poměru stran: mapa je skoro čtvercová a při plné
       šířce by byla přes celou obrazovku — vyhledávač by se pod ni nevešel. */
    height: clamp(340px, 68vh, 720px);
    overflow: hidden;
    background: var(--noc);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
  }

  /* Mapa vyplní rám. Bez zadané výšky by si ji knihovna spočítala jako
     nulovou a z mapy by zbyl proužek. */
  .mapa-platno {
    position: absolute;
    inset: 0;
  }

  .mapa-znacky[hidden] {
    display: none;
  }

  /* Obal, kterému polohu nastavuje mapa. Sám nesmí mít žádný vlastní
     `transform` — přepsal by ten, kterým si ho mapa drží na místě.
     Všechno posouvání a zvětšování se proto děje až uvnitř něj. */
  .znacka {
    display: block;
    line-height: 0;
  }

  .znacka[hidden] {
    display: none;
  }

  .budova-pin,
  .moje-adresa {
    display: block;
    border-radius: 999px;
  }

  /* Značka místnosti je tlačítko, ne tečka. Plochy oblastí se u sebe
     překrývají, takže klik těsně vedle značky často vybere sousední oblast —
     a klik přímo na ni dřív nedělal vůbec nic, protože značka leží nad mapou
     a klik se do plochy pod ní nedostal. Takhle vybere tu svoji vždycky
     a dosáhne na ni i klávesnice. */
  .budova-pin {
    width: 0.8rem;
    height: 0.8rem;
    padding: 0;
    border: 2px solid rgb(255 255 255 / 0.85);
    background: var(--noc);
    box-shadow: 0 1px 5px rgb(0 0 0 / 0.6);
    cursor: pointer;
    transition: transform var(--prechod), background var(--prechod);
  }

  .budova-pin:hover {
    transform: scale(1.35);
  }

  .znacka[data-vybrany] .budova-pin {
    transform: scale(1.9);
    background: var(--zelena);
    border-color: #fff;
  }

  .moje-adresa {
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--zelena);
    background: #fff;
    box-shadow: 0 0 0 4px rgb(91 174 57 / 0.3);
  }

  /* ---------- Popisky po výběru ---------- */

  .popis-mapy {
    display: block;
    width: max-content;
    max-width: 14rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-maly);
    font-size: var(--text-drobny);
    line-height: 1.35;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.5);
  }

  /* Popisky míří od svého bodu pryč, aby nezakrývaly to, na co ukazují. */
  .popis-adresy {
    transform: translate(-50%, -175%);
    background: var(--zelena);
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
  }

  .popis-cile {
    transform: translate(-50%, 30%);
    background: #f2f6f9;
    color: var(--noc);
    font-weight: 600;
    text-align: center;
  }

  .popis-cile span {
    font-weight: 400;
    color: #40566a;
  }

  /* ---------- Ovládání zvětšení ---------- */

  .mapa-ovladani {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 5;
    display: flex;
    gap: 0.35rem;
  }

  .mapa-ovladani[hidden] {
    display: none;
  }

  .mapa-ovladani button {
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding-inline: 0.6rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius-maly);
    background: var(--mapa-lista);
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-maly);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background var(--prechod), border-color var(--prechod);
  }

  .mapa-ovladani button:hover:not(:disabled) {
    background: var(--noc-svetlejsi);
    border-color: var(--na-noci-tlum);
  }

  .mapa-ovladani button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .mapa-ovladani [data-zoom='reset'] {
    font-size: var(--text-drobny);
  }

  /* ---------- Bez JavaScriptu ----------
     Mapa je vektorová a bez skriptu se nevykreslí. Místo prázdného rámu se
     ukáže obrázek téže mapy a odkaz na seznam místností, který funguje
     i bez skriptu. */

  .mapa-nahrada {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mapa-bez-js {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: var(--mapa-lista);
    color: var(--na-noci);
    font-size: var(--text-drobny);
  }

  /* ---------- Seznam místností ----------
     Je tu hlavně kvůli tomu, aby stránka odpověděla i bez JavaScriptu, kde
     mapa ani vyhledávač nefungují. Hodí se ale i jinak: kdo svoji místnost
     zná jménem, najde ji rychleji v seznamu než klikáním do mapy. */

  /* Žádné odsazení shora: vedle sebe musí obě krabice začínat na stejném
     řádku. Mezeru mezi nimi dělá `gap` mřížky, a když se dostanou pod sebe
     (úzký displej), taky. */
  .vsechny-mistnosti {
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius-maly);
  }

  .vsechny-mistnosti summary {
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    font-size: var(--text-maly);
    font-weight: 600;
    color: var(--na-noci);
  }

  .vsechny-mistnosti ol {
    margin: 0;
    padding: 0 0.9rem 0.9rem 2.6rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-maly);
    color: var(--na-noci-tlum);
  }

  .vsechny-mistnosti strong {
    color: var(--na-noci);
    font-weight: 600;
  }

  .mistnost-okrsky {
    display: block;
    font-size: var(--text-drobny);
  }


  /* ---------- Pod mapou ---------- */

  .pod-mapou {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  @media (min-width: 820px) {
    .pod-mapou {
      grid-template-columns: 1.4fr 1fr;
      /* Zarovnání nahoru, ne na výšku řádku. Díky tomu rozbalení seznamu
         místností nikam neposune to, co stojí vedle. */
      align-items: start;
      gap: 2rem;
    }

    /* Poznámka o zdrojích se vztahuje k mapě nad ní, takže jde přes celou
       šířku. Pod ní pak stojí vedle sebe „kdy se volí" a seznam místností. */
    .mapa-zdroj {
      grid-column: 1 / -1;
    }
  }

  .mapa-zdroj {
    max-width: var(--sirka-textu);
    margin: 0;
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
  }

  .kdy {
    padding: 1rem 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
  }

  .kdy h3 {
    color: var(--na-noci);
  }

  .kdy ul {
    display: grid;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kdy li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-maly);
  }

  .kdy-cas {
    font-variant-numeric: tabular-nums;
    color: var(--na-noci-tlum);
  }

  .kdy-pozn {
    margin: 0.9rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--linka-na-noci);
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
  }
</style>

<script>
  import maplibre from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { vytvorMapu } from '../lib/mapa-zaklad';

  const prvekDat = document.querySelector('[data-mapa-data]');
  const { cestaKDatum, cestaKPlocham, budovy, obydlene, barvyOblasti, barvaVybrane } = JSON.parse(
    prvekDat?.textContent || '{}',
  );

  const mapa = document.querySelector('[data-mapa]');
  const platno = document.querySelector('[data-mapa-platno]');
  const znacky = document.querySelector('[data-mapa-znacky]');
  const ovladani = document.querySelector('[data-mapa-ovladani]');
  const oddil = document.querySelector('[data-hledani]');
  const vstup = document.querySelector('[data-vstup]');
  const navrhy = document.querySelector('[data-navrhy]');
  const stav = document.querySelector('[data-stav]');
  const smazat = document.querySelector('[data-smazat]');
  const moje = document.querySelector('[data-moje]');
  const karta = document.querySelector('[data-karta]');
  const vyzva = document.querySelector('[data-vyzva]');
  const kartaObsah = document.querySelector('[data-karta-obsah]');
  const popisAdresyPrvek = document.querySelector('[data-popis-adresy]');
  const popisCile = document.querySelector('[data-popis-cile]');

  const zjednodus = (t) =>
    t.normalize('NFD').replace(/\p{Mn}/gu, '').toLowerCase().replace(/\s+/g, ' ').trim();

  /* ------------------------------------------------------------------ *
   *  Mapa                                                               *
   * ------------------------------------------------------------------ */

  /** Volá se po výběru budovy. Naplní se až se postavením mapy. */
  let ukazOblast = () => {};
  /** Doveze mapu k bydlišti i k volební místnosti zároveň. */
  let ukazCestu = () => {};
  /** Přesune značku na zadané místo a ukáže ji. */
  const postav = (obal, lat, lon) => {
    if (!obal) return;
    obal.hidden = false;
    obal.__znacka?.setLngLat([lon, lat]);
  };

  if (mapa && platno && znacky && ovladani) {
    const mapaGl = vytvorMapu({
      prvek: platno,
      stred: [(obydlene[0][0] + obydlene[1][0]) / 2, (obydlene[0][1] + obydlene[1][1]) / 2],
      zoom: 12,
      opatrneOvladani: true,
    });

    /**
     * Výchozí pohled: celá obydlená část obce. Kdo bydlí v Rychtářově nebo
     * na Hamiltonech, musí svou čtvrť vidět hned — přiblížit si ji umí
     * každý sám, ale hledat ji posouváním po výřezu, ve kterém není, je
     * otrava.
     */
    const ODSTUP = 28;
    const naCelek = (animovat) =>
      mapaGl.fitBounds(obydlene, { padding: ODSTUP, animate: animovat });
    naCelek(false);
    mapaGl.once('load', () => naCelek(false));

    // --- Značky ---
    // Seznam se musí vzít TEĎ. Jakmile značku převezme mapa, přestěhuje si
    // její prvek do vlastního obalu — a `znacky` pak zůstane prázdné.
    znacky.hidden = false;
    const obaly = [...znacky.querySelectorAll('.znacka')];
    for (const obal of obaly) {
      const lat = Number(obal.dataset.lat);
      const lon = Number(obal.dataset.lon);
      // Popisky a bod bydliště souřadnice zatím nemají — dostanou je, až
      // člověk něco vybere. Do té doby stojí značka mimo obraz.
      obal.__znacka = new maplibre.Marker({ element: obal })
        .setLngLat(Number.isFinite(lat) ? [lon, lat] : obydlene[0])
        .addTo(mapaGl);

      const tlacitkoPinu = obal.querySelector('.budova-pin');
      if (tlacitkoPinu) {
        tlacitkoPinu.addEventListener('click', (e) => {
          // Značka leží uvnitř mapy, takže klik na ni probublá až k ní a mapa
          // si pak vybere oblast pod kurzorem sama — a protože se plochy
          // překrývají, klidně jinou, než ke které značka patří. Musí se tedy
          // zarazit tady.
          e.stopPropagation();
          ukazBudovu(Number(obal.dataset.pinBudova));
          skryjHledanou();
        });
      }
    }

    // --- Plochy oblastí ---
    mapaGl.on('load', () => {
      mapaGl.addSource('oblasti', { type: 'geojson', data: cestaKPlocham });

      // Barevné plochy patří POD ulice, ne nad ně. Když ležely nahoře,
      // překryly silnice i řeku a z mapy byla mazanice, ve které se nedalo
      // orientovat. `cesty-zpevnene` je první vrstva komunikací ve stylu.
      const podUlice = 'cesty-zpevnene';

      mapaGl.addLayer(
        {
          id: 'oblasti-plocha',
          type: 'fill',
          source: 'oblasti',
          paint: {
            'fill-color': [
              'match',
              ['get', 'barva'],
              ...barvyOblasti.flatMap((barva, i) => [i, barva]),
              barvyOblasti[0],
            ],
            // Průsvitně, aby pod barvou zůstaly vidět ulice a zástavba.
            'fill-opacity': 0.34,
          },
        },
        podUlice,
      );

      mapaGl.addLayer(
        {
          id: 'oblasti-obrys',
          type: 'line',
          source: 'oblasti',
          // Obrys drží tvar pohromadě i tam, kde spolu sousedí dvě podobné
          // barvy. Bez něj se v centru slily do jedné skvrny.
          paint: { 'line-color': '#ffffff', 'line-opacity': 0.35, 'line-width': 1 },
        },
        podUlice,
      );

      // Vybraná oblast je zelená a kreslí se navrchu, aby ji nic nepřekrylo.
      // Zelená je na téhle mapě vyhrazená právě jí — v paletě ostatních
      // oblastí proto není, jinak by nešlo poznat, která je ta vaše.
      mapaGl.addLayer({
        id: 'oblasti-vybrana',
        type: 'fill',
        source: 'oblasti',
        filter: ['==', ['get', 'budova'], -1],
        paint: { 'fill-color': barvaVybrane, 'fill-opacity': 0.55 },
      });
      mapaGl.addLayer({
        id: 'oblasti-vybrana-obrys',
        type: 'line',
        source: 'oblasti',
        filter: ['==', ['get', 'budova'], -1],
        paint: { 'line-color': '#ffffff', 'line-width': 2 },
      });

      // Spojnice mezi bydlištěm a volební místností — ukáže, kterým směrem
      // to je. Prázdná do chvíle, než člověk vyhledá adresu.
      mapaGl.addSource('spojnice', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: [] },
      });
      // Bílá, ne zelená. Spojnice vede skoro vždycky napříč vybranou
      // oblastí — a ta je zelená, takže zelená čára v ní zmizela.
      mapaGl.addLayer({
        id: 'spojnice',
        type: 'line',
        source: 'spojnice',
        layout: { 'line-cap': 'round' },
        paint: {
          'line-color': '#ffffff',
          'line-width': 3,
          'line-dasharray': [0.1, 1.9],
        },
      });
    });

    ukazOblast = (index) => {
      for (const vrstva of ['oblasti-vybrana', 'oblasti-vybrana-obrys']) {
        if (mapaGl.getLayer(vrstva)) {
          mapaGl.setFilter(vrstva, ['==', ['get', 'budova'], index ?? -1]);
        }
      }
      for (const obal of obaly) {
        if (obal.dataset.pinBudova == null) continue;
        obal.toggleAttribute('data-vybrany', Number(obal.dataset.pinBudova) === index);
      }
    };

    ukazCestu = (odkud, kam) => {
      // Příznak je na obalu mapy schválně: spojnici kreslí knihovna do plátna,
      // takže zvenčí — ze zkoušky — není jak poznat, že tam je.
      mapa.dataset.cesta = odkud && kam ? 'ano' : 'ne';
      const zdroj = mapaGl.getSource('spojnice');
      if (zdroj) {
        zdroj.setData({
          type: 'FeatureCollection',
          features:
            odkud && kam
              ? [
                  {
                    type: 'Feature',
                    properties: {},
                    geometry: {
                      type: 'LineString',
                      coordinates: [
                        [odkud.lon, odkud.lat],
                        [kam.lon, kam.lat],
                      ],
                    },
                  },
                ]
              : [],
        });
      }
      if (!odkud) return;
      if (kam) {
        // Odstup je tu větší: u obou konců visí popisek, který by se jinak
        // nevešel do rámu a zůstal by useknutý.
        mapaGl.fitBounds(
          [
            [Math.min(odkud.lon, kam.lon), Math.min(odkud.lat, kam.lat)],
            [Math.max(odkud.lon, kam.lon), Math.max(odkud.lat, kam.lat)],
          ],
          { padding: { top: 90, bottom: 70, left: 70, right: 70 }, maxZoom: 16 },
        );
      } else {
        mapaGl.easeTo({ center: [odkud.lon, odkud.lat], zoom: 15 });
      }
    };

    // --- Klik do plochy vybere oblast ---
    mapaGl.on('click', 'oblasti-plocha', (e) => {
      const index = e.features?.[0]?.properties?.budova;
      if (index == null) return;
      ukazBudovu(index);
      // Popisek adresy i spojnice patří jen k vyhledané adrese.
      skryjHledanou();
    });
    mapaGl.on('mouseenter', 'oblasti-plocha', () => {
      mapaGl.getCanvas().style.cursor = 'pointer';
    });
    mapaGl.on('mouseleave', 'oblasti-plocha', () => {
      mapaGl.getCanvas().style.cursor = '';
    });

    // --- Ovládání přiblížení ---
    ovladani.hidden = false;
    const tlacitko = (co) => ovladani.querySelector('[data-zoom="' + co + '"]');

    ovladani.addEventListener('click', (e) => {
      const co = e.target.closest('[data-zoom]')?.dataset.zoom;
      if (co === 'dovnitr') mapaGl.zoomIn();
      else if (co === 'ven') mapaGl.zoomOut();
      else if (co === 'reset') naCelek(true);
    });

    const stavTlacitek = () => {
      const z = mapaGl.getZoom();
      tlacitko('dovnitr').disabled = z >= mapaGl.getMaxZoom() - 0.01;
      tlacitko('ven').disabled = z <= mapaGl.getMinZoom() + 0.01;
    };
    mapaGl.on('zoom', stavTlacitek);
    stavTlacitek();
  }

  /* ------------------------------------------------------------------ *
   *  Výběr budovy                                                       *
   * ------------------------------------------------------------------ */

  function ukazPopisCile(b) {
    if (!popisCile) return;
    const text = popisCile.querySelector('.popis-cile');
    text.innerHTML = '';
    text.append(document.createTextNode(b.nazev));
    const adresa = document.createElement('span');
    adresa.textContent = ', ' + b.adresa;
    text.append(adresa);
    postav(popisCile, b.lat, b.lon);
  }

  /** Schová všechno, co patří k vyhledané adrese, ale ne k vybrané oblasti. */
  function skryjHledanou() {
    if (moje) moje.hidden = true;
    if (popisAdresyPrvek) popisAdresyPrvek.hidden = true;
    ukazCestu(null, null);
    if (vstup) vstup.value = '';
    if (smazat) smazat.hidden = true;
  }

  function ukazBudovu(index, vlastniAdresa) {
    const b = budovy[index];
    if (!b) return;

    ukazOblast(index);

    karta.toggleAttribute('data-vybrano', true);
    vyzva.hidden = true;
    kartaObsah.hidden = false;
    kartaObsah.innerHTML = '';

    const nadtitulek = document.createElement('p');
    nadtitulek.className = 'karta-nadtitulek';
    nadtitulek.textContent = 'Volební místnost';
    kartaObsah.append(nadtitulek);

    const misto = document.createElement('p');
    misto.className = 'karta-misto';
    misto.append(document.createTextNode(b.nazev));
    const adresa = document.createElement('span');
    adresa.textContent = ', ' + b.adresa;
    misto.append(adresa);
    kartaObsah.append(misto);

    if (b.bezbarierovy) {
      const bez = document.createElement('p');
      bez.className = 'karta-doplnek';
      bez.textContent = '♿ Bezbariérový přístup';
      kartaObsah.append(bez);
    }

    if (vlastniAdresa) {
      const vase = document.createElement('p');
      vase.className = 'karta-vase';
      vase.textContent = 'Pro adresu ' + vlastniAdresa;
      kartaObsah.append(vase);
    }

    ukazPopisCile(b);
  }

  function zrusVyber() {
    ukazOblast(null);
    karta.removeAttribute('data-vybrano');
    vyzva.hidden = false;
    kartaObsah.hidden = true;
    if (popisCile) popisCile.hidden = true;
    skryjHledanou();
  }

  /* ------------------------------------------------------------------ *
   *  Vyhledávání adresy                                                 *
   * ------------------------------------------------------------------ */

  if (oddil && vstup) {
    oddil.hidden = false;

    let adresy = null;
    let nacitam = null;
    let vybrany = -1;
    let aktualni = [];

    async function zajistiData() {
      if (adresy) return adresy;
      if (!nacitam) {
        stav.textContent = 'Načítám seznam adres…';
        nacitam = fetch(cestaKDatum)
          .then((o) => {
            if (!o.ok) throw new Error(String(o.status));
            return o.json();
          })
          .then((d) => {
            adresy = d.adresy.map((a) => ({
              ulice: d.ulice[a[0]],
              co: a[1],
              cp: a[2],
              budova: d.okrsekNaBudovu[a[3]],
              lat: a[4],
              lon: a[5],
              cast: d.casti[a[6]],
              uliceKlic: zjednodus(d.ulice[a[0]]),
            }));
            stav.textContent = '';
            return adresy;
          })
          .catch(() => {
            stav.textContent = 'Seznam adres se nepodařilo načíst. Zkuste to prosím znovu.';
            nacitam = null;
            return null;
          });
      }
      return nacitam;
    }

    /**
     * Rozebere, co člověk napsal, na ulici a číslo.
     *
     * Musí zvládnout „Dukelská 12", „dukelska12", „Dukelská 12/345"
     * i „Dukelská 345/12" — někdo zná svůj dům podle orientačního čísla,
     * někdo podle popisného a pořadí si nikdo nepamatuje.
     */
    function rozeber(text) {
      const t = zjednodus(text).replace(/[,;]/g, ' ');
      const shoda = t.match(/^(.*?[a-z])\s*(\d+[a-z]?)(?:\s*\/\s*(\d+[a-z]?))?\s*$/);
      if (shoda) return { ulice: shoda[1].trim(), cisla: [shoda[2], shoda[3]].filter(Boolean) };
      return { ulice: t.trim(), cisla: [] };
    }

    function hodnoceni(a, ulice, cisla) {
      const zacina = a.uliceKlic.startsWith(ulice);
      if (!zacina && !a.uliceKlic.includes(ulice)) return -1;
      const body = zacina ? 100 : 50;
      if (!cisla.length) return body;
      const co = zjednodus(a.co);
      const cp = zjednodus(a.cp);
      const sedi = cisla.filter((c) => c === co || c === cp).length;
      if (!sedi) return -1;
      // Shoda na obou číslech je jistota, shoda na orientačním má přednost.
      return body + sedi * 100 + (cisla.some((c) => c === co) ? 10 : 0);
    }

    function popisAdresy(a) {
      const cisla = a.co && a.cp ? a.co + '/' + a.cp : a.co || a.cp;
      return a.ulice + ' ' + cisla;
    }

    function vykresliNavrhy(seznam) {
      navrhy.innerHTML = '';
      aktualni = seznam;
      vybrany = -1;
      if (!seznam.length) {
        navrhy.hidden = true;
        vstup.setAttribute('aria-expanded', 'false');
        return;
      }
      seznam.forEach((a, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = 'navrh-' + i;
        li.append(document.createTextNode(popisAdresy(a)));
        const cast = document.createElement('span');
        cast.className = 'navrh-cast';
        cast.textContent = ', ' + a.cast;
        li.append(cast);
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          vyber(i);
        });
        navrhy.append(li);
      });
      navrhy.hidden = false;
      vstup.setAttribute('aria-expanded', 'true');
    }

    function vyber(i) {
      const a = aktualni[i];
      if (!a) return;
      vstup.value = popisAdresy(a);
      navrhy.hidden = true;
      vstup.setAttribute('aria-expanded', 'false');

      ukazBudovu(a.budova, popisAdresy(a) + ', ' + a.cast);

      const cil = budovy[a.budova];
      postav(moje, a.lat, a.lon);

      // Do mapy se vypíše obojí: kde člověk bydlí a kam má jít.
      if (popisAdresyPrvek) {
        popisAdresyPrvek.querySelector('.popis-adresy').textContent = popisAdresy(a);
        postav(popisAdresyPrvek, a.lat, a.lon);
      }
      ukazCestu({ lat: a.lat, lon: a.lon }, cil);
    }

    async function hledej() {
      smazat.hidden = !vstup.value;
      const { ulice, cisla } = rozeber(vstup.value);
      if (ulice.length < 2) {
        vykresliNavrhy([]);
        return;
      }
      const vsechny = await zajistiData();
      if (!vsechny) return;

      const nalez = vsechny
        .map((a) => ({ a, skore: hodnoceni(a, ulice, cisla) }))
        .filter((z) => z.skore >= 0)
        .sort((p, q) => q.skore - p.skore)
        .slice(0, 12)
        .map((z) => z.a);

      vykresliNavrhy(nalez);
      stav.textContent = nalez.length ? '' : 'Takovou adresu ve Vyškově nenacházím.';
    }

    vstup.addEventListener('input', hledej);
    vstup.addEventListener('focus', hledej);

    vstup.addEventListener('keydown', (e) => {
      if (navrhy.hidden) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        vybrany = (vybrany + (e.key === 'ArrowDown' ? 1 : -1) + aktualni.length) % aktualni.length;
        for (const [i, li] of [...navrhy.children].entries()) {
          li.toggleAttribute('data-vybrany', i === vybrany);
        }
        vstup.setAttribute('aria-activedescendant', 'navrh-' + vybrany);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        vyber(vybrany >= 0 ? vybrany : 0);
      } else if (e.key === 'Escape') {
        navrhy.hidden = true;
        vstup.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (e) => {
      if (!oddil.contains(e.target)) {
        navrhy.hidden = true;
        vstup.setAttribute('aria-expanded', 'false');
      }
    });

    smazat.addEventListener('click', () => {
      vstup.value = '';
      smazat.hidden = true;
      navrhy.hidden = true;
      stav.textContent = '';
      zrusVyber();
      vstup.focus();
    });

    oddil.addEventListener('submit', (e) => e.preventDefault());
  }

</script>
