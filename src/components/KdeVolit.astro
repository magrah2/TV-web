    padding: 0.9rem 2.8rem 0.9rem 1rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    background: var(--noc-svetlejsi);
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-velky);
  }

  .hledani input::placeholder {
    color: var(--na-noci-tlum);
  }

