---
/**
 * Kde volit — mapa volebních budov a vyhledávač adresy.
 *
 * Dvě cesty ke stejné odpovědi: buď člověk napíše adresu, nebo si klikne
 * do mapy na svoje okolí. Obojí vede na stejnou kartu s volební místností.
 *
 * Mapa je rozdělená podle BUDOV, ne podle okrsků. Voliče nezajímá číslo
 * okrsku, ale do které budovy má jít — a když několik okrsků volí na stejném
 * místě, jsou to z jeho pohledu jedna oblast.
 *
 * Data o okrscích jsou z otevřených dat ČÚZK (RÚIAN), kde je ke každé adrese
 * v obci uvedené číslo volebního okrsku; vymezení tam zapisuje starosta.
 * Seznam volebních místností je přepsaný z úřední vyhlášky města, protože ten
 * v otevřených datech není. Obojí připravuje `nastroje/okrsky.mjs`.
 *
 * Adresy se NEVKLÁDAJÍ do stránky — je jich skoro šest tisíc a HTML by
 * nabobtnalo. Načtou se až ve chvíli, kdy je člověk potřebuje.
 */

import fs from 'node:fs';
import { VOLEBNI_DNY, SOUBEZNE_VOLBY } from '../lib/volebni-mistnosti';
import { odkaz } from '../lib/odkaz';
import podkladObec from '../../public/mapa-obec.svg?raw';
import plochyBudov from '../../public/mapa-okrsky.svg?raw';
import vyrez from '../lib/mapa-vyrez-obec.json';

// --- Jedna mapa místo dvou -------------------------------------------------
// Podklad i plochy se slévají do JEDNOHO svg. Zvětšování se totiž dělá změnou
// `viewBox` a dvě samostatná svg by se musela držet v zákrytu ručně.
const skupinyPloch = plochyBudov.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');

// Barevné plochy patří POD ulice, ne nad ně. Když ležely nahoře, překryly
// silnice i řeku a z mapy byla mazanice, ve které se nedalo orientovat.
// Vkládají se proto těsně před první vrstvu komunikací.
const kamSPlochami = podkladObec.indexOf('<g class="mapa-ulice">');
if (kamSPlochami < 0) throw new Error('V podkladu mapy chybí vrstva ulic — kam vložit plochy?');

// Spojnice mezi adresou a volební místností se kreslí až po vyhledání.
// Ta naopak patří úplně nahoru, aby ji nic nepřekrylo.
const spojnice = '\n  <g class="spojnice"><path d=""/></g>';

const mapaSpojena = (
  podkladObec.slice(0, kamSPlochami) +
  skupinyPloch +
  '\n' +
  podkladObec.slice(kamSPlochami)
).replace(/<\/svg>\s*$/, spojnice + '\n</svg>');

// --- Data ------------------------------------------------------------------

const data = JSON.parse(fs.readFileSync('public/data/okrsky.json', 'utf8')) as {
  ulice: string[];
  casti: string[];
  budovy: { nazev: string; adresa: string; bezbarierovy: boolean; okrsky: number[]; barva: number }[];
  okrsekNaBudovu: Record<string, number>;
  adresy: [number, string, string, number, number, number, number][];
};

const zjednodus = (t: string) =>
  t.normalize('NFD').replace(/\p{Mn}/gu, '').toLowerCase().replace(/\s+/g, ' ').trim();

const vsechnyAdresy = data.adresy.map((a) => ({
  ulice: data.ulice[a[0]],
  co: a[1],
  cp: a[2],
  lat: a[4],
  lon: a[5],
}));

/** Dohledá souřadnice volební místnosti podle její adresy z vyhlášky. */
function najdiAdresu(popis: string) {
  // „Slovanská 111, Hamiltony" — část za čárkou je upřesnění, ne adresa.
  const shoda = popis.split(',')[0].trim().match(/^(.*?)\s+(\S+)$/);
  if (!shoda) throw new Error(`Adresu volební místnosti "${popis}" neumím rozebrat.`);
  const [, ulice, cislaText] = shoda;
  const uliceKlic = zjednodus(ulice);
  // „Dědická 104/130" — v datech je zvlášť číslo popisné a orientační.
  const cisla = cislaText.split('/').map(zjednodus);

  // Vyhláška píše adresy tak, jak jsou na domech — tedy číslem orientačním.
  // Hledá se proto NEJDŘÍV podle něj a teprve pak podle popisného. Bez toho
  // pořadí by „Slovanská 111" mohla trefit dům o dvě stě metrů vedle,
  // protože stejné číslo existuje v obou řadách.
  for (const podle of ['co', 'cp'] as const) {
    for (const c of cisla) {
      const nalez = vsechnyAdresy.find(
        (a) => zjednodus(a.ulice) === uliceKlic && zjednodus(a[podle]) === c,
      );
      if (nalez) return nalez;
    }
  }
  throw new Error(
    `Volební místnost "${popis}" jsem v datech ČÚZK nenašel. ` +
      `Zkontrolujte adresu v src/lib/volebni-mistnosti.json.`,
  );
}

// Mercator — stejná projekce jako u generátoru mapy. Výsledek je v jednotkách
// mapy (0…1000 × 0…974), ne v procentech: viewBox pracuje právě s nimi.
const merkator = (lat: number) => Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 180 / 2));
const yJih = merkator(vyrez.jih);
const MERITKO = vyrez.sirka / (vyrez.vychod - vyrez.zapad);
const naMapu = (lat: number, lon: number) => ({
  mx: +((lon - vyrez.zapad) * MERITKO).toFixed(1),
  my: +(vyrez.vyska - (merkator(lat) - yJih) * (180 / Math.PI) * MERITKO).toFixed(1),
});

const budovy = data.budovy.map((b) => {
  const adresa = najdiAdresu(b.adresa);
  return { ...b, ...naMapu(adresa.lat, adresa.lon) };
});

// --- Popisky místních částí -----------------------------------------------
// Bez nich se v mapě špatně orientuje: člověk vidí barevné plochy, ale neví,
// jestli se dívá na Dědice nebo na Rychtářov. Těžiště se počítá z adres, takže
// popisek sedí tam, kde ta část obce doopravdy je.
const soucty = new Map<string, { lat: number; lon: number; pocet: number }>();
for (const a of data.adresy) {
  const nazev = data.casti[a[6]];
  const s = soucty.get(nazev) ?? { lat: 0, lon: 0, pocet: 0 };
  s.lat += a[4];
  s.lon += a[5];
  s.pocet += 1;
  soucty.set(nazev, s);
}
const popisky = [...soucty].map(([nazev, s]) => ({
  nazev,
  pocet: s.pocet,
  ...naMapu(s.lat / s.pocet, s.lon / s.pocet),
}));

// --- Obydlená plocha -------------------------------------------------------
// Výřez mapy zabírá celé katastrální území včetně polí a lesů, kde nikdo
// nebydlí. Kdyby se výchozí pohled řídil jím, obec by se scvrkla doprostřed
// a názvy částí by se v ní slily. Pohled se proto řídí rozsahem adres —
// vidět je pořád všechno až po Rychtářov, ale vyplní to rám.
const body = data.adresy.map((a) => naMapu(a[4], a[5]));
const celek = {
  x1: Math.min(...body.map((b) => b.mx)),
  x2: Math.max(...body.map((b) => b.mx)),
  y1: Math.min(...body.map((b) => b.my)),
  y2: Math.max(...body.map((b) => b.my)),
};

---

<section class="kde-volit pas-noc" id="kde-volit">
  <div class="pruh">
    <p class="nadtitulek">Kde volit</p>
    <h2 class="kde-nadpis">Napište adresu, nebo si klikněte do&nbsp;mapy</h2>
    <p class="perex kde-perex">
      Volební místnost se řídí tím, kde máte trvalý pobyt. Každá barva na mapě je jedna
      budova, do které se v jejím okolí chodí volit.
    </p>

    <div class="kde-ovladaci">
      {/* Bez JavaScriptu vyhledávač nefunguje, takže je schovaný a odkrývá ho
          až skript. Mapa a časy zůstanou čitelné tak jako tak. */}
      <form class="hledani" data-hledani hidden autocomplete="off">
        <label class="hledani-popisek" for="adresa">Vaše adresa ve Vyškově</label>
        <div class="hledani-pole">
          <input
            type="text"
            id="adresa"
            name="adresa"
            placeholder="například Dukelská 12"
            role="combobox"
            aria-expanded="false"
            aria-controls="navrhy"
            aria-autocomplete="list"
            data-vstup
          />
          <button type="button" class="hledani-smazat" data-smazat hidden aria-label="Smazat">×</button>
        </div>
        <ul class="navrhy" id="navrhy" role="listbox" data-navrhy hidden></ul>
        <p class="hledani-stav" data-stav aria-live="polite"></p>
      </form>

      <div class="karta" data-karta>
        <p class="karta-vyzva" data-vyzva>
          Klikněte na barevnou plochu v mapě, nebo si najděte svoji adresu.
        </p>
        <div class="karta-obsah" data-karta-obsah hidden aria-live="polite"></div>
      </div>
    </div>

    {/* ---------- Mapa ---------- */}
    <div class="mapa-plocha" data-mapa>
      <Fragment set:html={mapaSpojena} />

      <div class="mapa-body">
        {popisky.map((p) => <span class="popisek-casti" data-mx={p.mx} data-my={p.my} data-pocet={p.pocet}>{p.nazev}</span>)}
        {
          budovy.map((b, i) => (
            <span
              class="budova-pin"
              data-pin-budova={i}
              data-mx={b.mx}
              data-my={b.my}
              title={`${b.nazev}, ${b.adresa}`}
            />
          ))
        }
        <span class="moje-adresa" data-moje hidden></span>

        {/* Popisky se doplňují až po výběru — do té doby by jen zabíraly místo. */}
        <span class="popis-mapy popis-adresy" data-popis-adresy hidden></span>
        <span class="popis-mapy popis-cile" data-popis-cile hidden></span>
      </div>

      <div class="mapa-ovladani" data-mapa-ovladani hidden>
        <button type="button" data-zoom="ven" aria-label="Oddálit mapu">−</button>
        <button type="button" data-zoom="dovnitr" aria-label="Přiblížit mapu">+</button>
        <button type="button" data-zoom="reset" aria-label="Zobrazit celou obec">Celá obec</button>
      </div>

      <p class="mapa-napoveda" data-napoveda>Kolečkem přiblížíte, tažením posunete</p>
    </div>

    <div class="pod-mapou">
      <p class="mapa-zdroj">
        Okrsky: data&nbsp;© ČÚZK (RÚIAN), CC&nbsp;BY&nbsp;4.0 · podklad: data&nbsp;©&nbsp;přispěvatelé OpenStreetMap.
        Plochy jsou odvozené z adres, nejsou to úřední hranice.
      </p>

      <div class="kdy">
        <h3>Kdy se volí</h3>
        <ul>
          {
            VOLEBNI_DNY.map((d) => (
              <li>
                <strong>{d.den}</strong> {d.datum}
                <span class="kdy-cas">{d.od}–{d.do}</span>
              </li>
            ))
          }
        </ul>
        <p class="kdy-pozn">
          Ve stejném termínu se volí i do {SOUBEZNE_VOLBY.nazev}. Dostanete tedy dvě sady
          lístků — druhé kolo senátních voleb je {SOUBEZNE_VOLBY.druheKoloOd} a {SOUBEZNE_VOLBY.druheKoloDo}.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .kde-volit {
    padding-block: var(--mezera-sekce);
  }

  .kde-nadpis {
    max-width: 24ch;
  }

  .kde-perex {
    margin-top: 0.9rem;
  }

  /* ---------- Vyhledávač a karta vedle sebe ---------- */

  .kde-ovladaci {
    display: grid;
    gap: 1rem;
    align-items: start;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-bottom: 1rem;
  }

  @media (min-width: 820px) {
    .kde-ovladaci {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  /* ---------- Hledání ---------- */

  .hledani {
    position: relative;
  }

  .hledani[hidden] {
    display: none;
  }

  .hledani-popisek {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--text-drobny);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--na-noci-tlum);
  }

  .hledani-pole {
    position: relative;
  }

  .hledani input {
    width: 100%;
    padding: 0.8rem 2.8rem 0.8rem 1rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    background: var(--noc-svetlejsi);
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-velky);
  }

  .hledani input::placeholder {
    color: var(--na-noci-tlum);
  }

  .hledani input:focus {
    border-color: #8fc4ec;
    outline: none;
  }

  .hledani-smazat {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 2rem;
    height: 2rem;
    transform: translateY(-50%);
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--na-noci-tlum);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .hledani-smazat:hover {
    color: var(--na-noci);
  }

  .navrhy {
    position: absolute;
    z-index: 8;
    left: 0;
    right: 0;
    max-height: 17rem;
    overflow-y: auto;
    margin: 0.35rem 0 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--noc-svetlejsi);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.5);
  }

  .navrhy[hidden] {
    display: none;
  }

  .navrhy li {
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-maly);
    font-size: var(--text-maly);
    cursor: pointer;
  }

  .navrhy li:hover,
  .navrhy li[data-vybrany] {
    background: rgb(255 255 255 / 0.1);
  }

  .navrh-cast {
    color: var(--na-noci-tlum);
  }

  .hledani-stav {
    margin: 0.5rem 0 0;
    font-size: var(--text-maly);
    color: var(--na-noci-tlum);
  }

  /* ---------- Karta s výsledkem ---------- */

  .karta {
    min-height: 100%;
    padding: 1rem 1.2rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    transition: background var(--prechod), border-color var(--prechod);
  }

  .karta[data-vybrano] {
    background: rgb(91 174 57 / 0.15);
    border-color: rgb(91 174 57 / 0.45);
  }

  .karta p {
    margin: 0;
  }

  .karta-vyzva {
    font-size: var(--text-maly);
    color: var(--na-noci-tlum);
  }

  .karta-vyzva[hidden],
  .karta-obsah[hidden] {
    display: none;
  }

  .karta-nadtitulek {
    font-size: var(--text-drobny);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9ed484;
  }

  .karta-misto {
    margin-top: 0.35rem !important;
    font-size: var(--text-nadpis-3);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--na-noci);
  }

  /* Adresa navazuje čárkou na název — „Základní škola Vyškov, Morávkova 40". */
  .karta-misto span {
    font-weight: 400;
    color: var(--na-noci-tlum);
  }

  .karta-doplnek {
    margin-top: 0.55rem !important;
    font-size: var(--text-drobny);
    color: #9ed484;
  }

  .karta-vase {
    margin-top: 0.55rem !important;
    padding-top: 0.55rem;
    border-top: 1px solid var(--linka-na-noci);
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
  }

  /* ---------- Mapa ---------- */

  .mapa-plocha {
    position: relative;
    /* Pevná výška místo poměru stran: mapa je skoro čtvercová a při plné
       šířce by byla přes celou obrazovku — vyhledávač by se pod ni nevešel. */
    height: clamp(340px, 68vh, 720px);
    overflow: hidden;
    background: #081a29;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
    /* Dvěma prsty se přibližuje mapa, jedním se roluje stránka.
       `pan-y` je tu nutné: bez něj si prohlížeč vezme štípnutí sám a přiblíží
       celou stránku, takže mapa se dvěma prsty vůbec zvětšit nedá. Úplné
       `none` se zapíná teprve u přiblížené mapy, kde má jeden prst posouvat
       mapu, ne stránku — kdyby platilo pořád, nešlo by se přes mapu na mobilu
       vůbec prorolovat. */
    touch-action: pan-y;
    cursor: grab;
  }

  .mapa-plocha[data-priblizeno] {
    touch-action: none;
  }

  .mapa-plocha[data-taham] {
    cursor: grabbing;
  }

  /* Mapa se zvětšuje změnou `viewBox`, ne přes `transform: scale()`.
     Se `scale()` si prohlížeč SVG jednou vykreslí do bitmapy a tu pak
     natahuje — při přiblížení z toho byly kostičky. Takhle se vektor
     překreslí a zůstane ostrý v jakémkoliv zvětšení. */
  .mapa-plocha :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Čáry si drží tloušťku na obrazovce, ať je mapa přiblížená jakkoliv.
     Bez tohohle by se při přiblížení z ulic staly dálnice. */
  .mapa-plocha :global(svg path) {
    vector-effect: non-scaling-stroke;
  }

  /* Podklad. Odstíny jsou v `tokeny.css` jako řada od nejtmavší po
     nejsvětlejší — mapa se zesvětluje posunutím celé řady najednou. */
  .mapa-plocha :global(.mapa-zastavba path) { fill: var(--mapa-zastavba); }
  .mapa-plocha :global(.mapa-prumysl path) { fill: var(--mapa-prumysl); }
  .mapa-plocha :global(.mapa-zelen path) { fill: var(--mapa-zelen); }
  .mapa-plocha :global(.mapa-vodni-plocha path) { fill: var(--mapa-voda); }
  .mapa-plocha :global(.mapa-ulice path) { fill: none; stroke: var(--mapa-ulice); stroke-width: 0.9; }
  .mapa-plocha :global(.mapa-silnice path) { fill: none; stroke: var(--mapa-silnice); stroke-width: 1.4; }
  .mapa-plocha :global(.mapa-silnice-hlavni path) { fill: none; stroke: var(--mapa-silnice-hlavni); stroke-width: 2.2; }
  .mapa-plocha :global(.mapa-zeleznice path) {
    fill: none;
    stroke: var(--mapa-zeleznice);
    stroke-width: 1;
    stroke-dasharray: 5 5;
  }
  .mapa-plocha :global(.mapa-potok path) { fill: none; stroke: var(--mapa-potok); stroke-width: 0.9; }
  .mapa-plocha :global(.mapa-reka path) { fill: none; stroke: var(--zelena); stroke-width: 2.4; opacity: 0.5; }

  /* ---------- Barvy oblastí ----------
     Jedna barva = jedna volební budova. Generátor je rozdělí tak, aby dvě
     sousední oblasti nikdy nedostaly stejnou. */

  .mapa-plocha :global(.budova-plocha path) {
    /* Průsvitně, aby pod barvou zůstaly vidět ulice a zástavba. Při vyšší
       sytosti se z mapy stala barevná deka, ve které se nedalo orientovat.

       Zkoušel jsem to snížit na 0,22, když se zesvětloval podklad, ale
       oblasti tím zbledly. Podklad je nově světlejší sám o sobě, takže
       se přes barvu vidí i při této sytosti a snižovat ji netřeba. */
    fill-opacity: 0.3;
    stroke: rgb(255 255 255 / 0.45);
    stroke-width: 1;
    stroke-linejoin: round;
    cursor: pointer;
    transition: fill-opacity var(--prechod), stroke var(--prechod);
  }

  /* Odstíny jsou seřazené tak, aby první čtyři — které se skutečně použijí —
     byly co nejdál od sebe. Dřív tu vedle sebe stála modrá a zelená v podobné
     světlosti a nešly rozeznat. Zelená se tu proto nepoužívá vůbec:
     je vyhrazená pro vybranou oblast. */
  .mapa-plocha :global(.budova-plocha[data-barva='0'] path) { fill: #2f7fd0; }
  .mapa-plocha :global(.budova-plocha[data-barva='1'] path) { fill: #d29a3a; }
  .mapa-plocha :global(.budova-plocha[data-barva='2'] path) { fill: #8a7fd0; }
  .mapa-plocha :global(.budova-plocha[data-barva='3'] path) { fill: #29a8b8; }
  .mapa-plocha :global(.budova-plocha[data-barva='4'] path) { fill: #c4708f; }
  .mapa-plocha :global(.budova-plocha[data-barva='5'] path) { fill: #7b93b8; }

  @media (hover: hover) {
    .mapa-plocha :global(.budova-plocha:hover path) {
      fill-opacity: 0.5;
      stroke: rgb(255 255 255 / 0.85);
    }
  }

  /* Vybraná oblast je jediná zelená na celé mapě — proto je hned jasné,
     která to je, i mezi patnácti dalšími. */
  .mapa-plocha :global(.budova-plocha[data-vybrany] path) {
    fill: var(--zelena);
    fill-opacity: 0.62;
    stroke: #fff;
    stroke-width: 2.5;
  }

  .mapa-body {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Značky jsou HTML nad mapou, ne uvnitř svg — díky tomu si drží velikost
     bez ohledu na přiblížení a polohu jim skript přepočítá podle viewBoxu. */
  .budova-pin,
  .moje-adresa {
    position: absolute;
    border-radius: 999px;
  }

  .budova-pin {
    width: 0.8rem;
    height: 0.8rem;
    margin: -0.4rem 0 0 -0.4rem;
    border: 2px solid rgb(255 255 255 / 0.85);
    background: var(--noc);
    box-shadow: 0 1px 5px rgb(0 0 0 / 0.6);
    transition: transform var(--prechod), background var(--prechod);
  }

  .budova-pin[data-vybrany] {
    transform: scale(1.9);
    background: var(--zelena);
    border-color: #fff;
    z-index: 3;
  }

  .moje-adresa {
    z-index: 4;
    width: 1rem;
    height: 1rem;
    margin: -0.5rem 0 0 -0.5rem;
    border: 3px solid var(--zelena);
    background: #fff;
    box-shadow: 0 0 0 4px rgb(91 174 57 / 0.3);
  }

  .budova-pin[hidden],
  .moje-adresa[hidden],
  .popisek-casti[hidden] {
    display: none;
  }

  /* Popisky místních částí. Bez nich se v mapě špatně hledá — barevné plochy
     samy o sobě neřeknou, jestli se člověk dívá na Dědice nebo na Rychtářov. */
  .popisek-casti {
    position: absolute;
    /* Výchozí poloha je na těžišti; kam nápis nakonec sedne, rozhodne
       `rozmistiPopisky()` — dopíše si vlastní `transform`. */
    transform: translate(-50%, -50%);
    white-space: nowrap;
    font-size: var(--text-drobny);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 0.92);
    /* Obrys místo podkladu — nápis je čitelný nad světlou i tmavou plochou
       a nezakrývá přitom mapu pod sebou. */
    paint-order: stroke;
    -webkit-text-stroke: 3px rgb(8 26 41 / 0.8);
    pointer-events: none;
  }

  /* ---------- Popisky po výběru ---------- */

  .popis-mapy {
    position: absolute;
    z-index: 6;
    max-width: 14rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-maly);
    font-size: var(--text-drobny);
    line-height: 1.35;
    pointer-events: none;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.5);
  }

  .popis-mapy[hidden] {
    display: none;
  }

  /* Popisky míří od svého bodu pryč, aby nezakrývaly to, na co ukazují. */
  .popis-adresy {
    transform: translate(-50%, -175%);
    background: var(--zelena);
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
  }

  .popis-cile {
    transform: translate(-50%, 30%);
    background: #f2f6f9;
    color: var(--noc);
    font-weight: 600;
    text-align: center;
  }

  .popis-cile span {
    font-weight: 400;
    color: #40566a;
  }

  /* Spojnice mezi bydlištěm a volební místností — ukáže, kterým směrem to je. */
  .mapa-plocha :global(.spojnice path) {
    fill: none;
    stroke: var(--zelena);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1 7;
  }

  .mapa-ovladani {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 5;
    display: flex;
    gap: 0.35rem;
  }

  .mapa-ovladani[hidden] {
    display: none;
  }

  .mapa-ovladani button {
    display: grid;
    place-items: center;
    min-width: 2.2rem;
    height: 2.2rem;
    padding-inline: 0.6rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius-maly);
    background: rgb(11 32 50 / 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-maly);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  .mapa-ovladani button:hover:not(:disabled) {
    background: var(--noc-svetlejsi);
  }

  .mapa-ovladani button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .mapa-ovladani [data-zoom='reset'] {
    font-size: var(--text-drobny);
  }

  .mapa-napoveda {
    position: absolute;
    left: 0.8rem;
    bottom: 0.9rem;
    margin: 0;
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
    pointer-events: none;
    transition: opacity var(--prechod);
  }

  .mapa-napoveda[hidden] {
    opacity: 0;
  }

  @media (max-width: 640px) {
    .mapa-napoveda {
      display: none;
    }
  }

  /* ---------- Pod mapou ---------- */

  .pod-mapou {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  @media (min-width: 820px) {
    .pod-mapou {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
      gap: 2rem;
    }
  }

  .mapa-zdroj {
    max-width: var(--sirka-textu);
    margin: 0;
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
  }

  .kdy {
    padding: 1rem 1.25rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius);
  }

  .kdy h3 {
    color: var(--na-noci);
  }

  .kdy ul {
    display: grid;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kdy li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-maly);
  }

  .kdy-cas {
    font-variant-numeric: tabular-nums;
    color: var(--na-noci-tlum);
  }

  .kdy-pozn {
    margin: 0.9rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--linka-na-noci);
    font-size: var(--text-drobny);
    color: var(--na-noci-tlum);
  }
</style>

<script define:vars={{ cestaKDatum: odkaz('/data/okrsky.json'), budovy, vyrez, celek }}>
  const mapa = document.querySelector('[data-mapa]');
  const svg = mapa?.querySelector('svg');
  const ovladani = document.querySelector('[data-mapa-ovladani]');
  const napoveda = document.querySelector('[data-napoveda]');
  const oddil = document.querySelector('[data-hledani]');
  const vstup = document.querySelector('[data-vstup]');
  const navrhy = document.querySelector('[data-navrhy]');
  const stav = document.querySelector('[data-stav]');
  const smazat = document.querySelector('[data-smazat]');
  const moje = document.querySelector('[data-moje]');
  const karta = document.querySelector('[data-karta]');
  const vyzva = document.querySelector('[data-vyzva]');
  const kartaObsah = document.querySelector('[data-karta-obsah]');
  const popisAdresyPrvek = document.querySelector('[data-popis-adresy]');
  const popisCile = document.querySelector('[data-popis-cile]');
  const spojnice = mapa?.querySelector('.spojnice path');

  const zjednodus = (t) =>
    t.normalize('NFD').replace(/\p{Mn}/gu, '').toLowerCase().replace(/\s+/g, ' ').trim();

  // Poloha v jednotkách mapy — stejná projekce jako u generátoru.
  const merkator = (lat) => Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 180 / 2));
  const yJih = merkator(vyrez.jih);
  const MERITKO = vyrez.sirka / (vyrez.vychod - vyrez.zapad);
  const naMapu = (lat, lon) => ({
    mx: (lon - vyrez.zapad) * MERITKO,
    my: vyrez.vyska - (merkator(lat) - yJih) * (180 / Math.PI) * MERITKO,
  });

  /* ------------------------------------------------------------------ *
   *  Mapa: viewBox, zvětšování, posouvání                               *
   * ------------------------------------------------------------------ */

  const NEJMENSI_SIRKA = vyrez.sirka / 16; // nejvyšší přiblížení

  // Kolem obce se nechává volné místo. Bez něj končí okrajové čtvrti natvrdo
  // u hrany rámu: přiblížení je drží u kraje, kde je vidět jen jejich půlka,
  // a doprostřed se posunout nedají, protože posun se zaráží o hranici mapy.
  const OKRAJ = Math.round(Math.max(celek.x2 - celek.x1, celek.y2 - celek.y1) * 0.07);
  const CELA_SIRKA = celek.x2 - celek.x1 + OKRAJ * 2;
  const CELA_VYSKA = celek.y2 - celek.y1 + OKRAJ * 2;
  const STRED_X = (celek.x1 + celek.x2) / 2;
  const STRED_Y = (celek.y1 + celek.y2) / 2;

  let pohled = { x: celek.x1 - OKRAJ, y: celek.y1 - OKRAJ, w: CELA_SIRKA };
  // Nápověda zmizí, jakmile člověk s mapou poprvé pohne — pak už ji nepotřebuje.
  let uzHnul = false;

  /** Poměr stran rámu. Měří se za běhu, protože výška mapy je daná v CSS. */
  const pomer = () => (mapa.clientHeight || 1) / (mapa.clientWidth || 1);

  /** Nejmenší přiblížení: takové, aby se celá obydlená plocha vešla do rámu. */
  const nejvetsiSirka = () => Math.max(CELA_SIRKA, CELA_VYSKA / pomer());

  function srovnej() {
    const maxW = nejvetsiSirka();
    pohled.w = Math.min(maxW, Math.max(NEJMENSI_SIRKA, pohled.w));
    const h = pohled.w * pomer();
    // Když je výřez větší než mapa, mapa se v něm vystředí — jinak by se
    // dala odsunout do prázdna.
    pohled.x =
      pohled.w >= CELA_SIRKA
        ? STRED_X - pohled.w / 2
        : Math.min(celek.x2 + OKRAJ - pohled.w, Math.max(celek.x1 - OKRAJ, pohled.x));
    pohled.y =
      h >= CELA_VYSKA
        ? STRED_Y - h / 2
        : Math.min(celek.y2 + OKRAJ - h, Math.max(celek.y1 - OKRAJ, pohled.y));
  }

  function vykresli() {
    if (!svg) return;
    srovnej();
    const h = pohled.w * pomer();
    svg.setAttribute('viewBox', `${pohled.x} ${pohled.y} ${pohled.w} ${h}`);

    // Značky jsou HTML, takže se přepočítávají zvlášť. Co je mimo výřez,
    // se schová — jinak by se hromadily na okraji.
    for (const znacka of mapa.querySelectorAll('[data-mx]')) {
      const x = ((Number(znacka.dataset.mx) - pohled.x) / pohled.w) * 100;
      const y = ((Number(znacka.dataset.my) - pohled.y) / h) * 100;
      znacka.style.left = x + '%';
      znacka.style.top = y + '%';
      if (!znacka.dataset.vzdyVidet) znacka.hidden = x < -3 || x > 103 || y < -3 || y > 103;
    }

    rozmistiPopisky();

    // Podle tohohle příznaku CSS přepíná `touch-action`: u přiblížené mapy
    // posouvá jeden prst mapu, u oddálené roluje stránku.
    mapa.toggleAttribute('data-priblizeno', pohled.w < nejvetsiSirka() - 0.01);

    if (ovladani) {
      const naDoraz = pohled.w >= nejvetsiSirka() - 0.01;
      ovladani.querySelector('[data-zoom="dovnitr"]').disabled = pohled.w <= NEJMENSI_SIRKA + 0.01;
      ovladani.querySelector('[data-zoom="ven"]').disabled = naDoraz;
      ovladani.querySelector('[data-zoom="reset"]').disabled = naDoraz;
      if (napoveda) napoveda.hidden = uzHnul;
    }
  }

  /**
   * Rozestoupí názvy místních částí.
   *
   * Ve středu města leží Vyškov-Město, Nosálovice, Nouzka, Brňany, Křečkovice
   * a Pazderna namačkané na sebe. Při oddálení se jejich názvy překrývají
   * navzájem i s body volebních místností a je z toho slepenec. Velikost té
   * části o tom rozhodnout nemůže — Vyškov-Město je stejně velké jako
   * Rychtářov, jen má sousedy. Rozhoduje proto skutečný překryv na obrazovce:
   * název se vykreslí, jen když se vejde vedle už vykreslených. Přednost mají
   * části s víc adresami. Jak se mapa přiblíží, místa přibude a zbylé názvy
   * naskočí samy.
   */
  function rozmistiPopisky() {
    const sirkaPx = mapa.clientWidth;
    const vyskaPx = mapa.clientHeight;
    if (!sirkaPx || !vyskaPx) return;

    const zabrane = [];
    const volno = (a) =>
      !zabrane.some((b) => a.x1 < b.x2 && a.x2 > b.x1 && a.y1 < b.y2 && a.y2 > b.y1);

    // Body volebních místností jsou důležitější než názvy — ty se jim uhnou.
    for (const pin of mapa.querySelectorAll('.budova-pin')) {
      if (pin.hidden) continue;
      const x = (parseFloat(pin.style.left) / 100) * sirkaPx;
      const y = (parseFloat(pin.style.top) / 100) * vyskaPx;
      zabrane.push({ x1: x - 11, y1: y - 11, x2: x + 11, y2: y + 11 });
    }

    // Změřit se dá jen to, co je vidět, takže se nejdřív měří a teprve pak
    // schovává. Uvnitř jednoho běhu se mezistav nevykreslí, takže to neproblikne.
    const merene = [];
    for (const p of mapa.querySelectorAll('.popisek-casti')) {
      if (p.hidden) continue;
      merene.push({
        prvek: p,
        pocet: Number(p.dataset.pocet),
        x: (parseFloat(p.style.left) / 100) * sirkaPx,
        y: (parseFloat(p.style.top) / 100) * vyskaPx,
        w: p.offsetWidth,
        h: p.offsetHeight,
      });
    }

    merene.sort((a, b) => b.pocet - a.pocet);
    for (const m of merene) {
      // Pořadí, ve kterém se název pokouší usadit. Nad bodem to vypadá
      // nejlíp, ale trvat na tom by ho zbytečně schovalo i tam, kde by se
      // kousek vedle v pohodě vešel.
      const kam = [
        [0, -m.h - 12],
        [0, m.h + 12],
        [m.w / 2 + 16, 0],
        [-m.w / 2 - 16, 0],
        [m.w / 2 + 14, -m.h - 4],
        [-m.w / 2 - 14, -m.h - 4],
      ];
      let usadil = null;
      for (const [dxKam, dyKam] of kam) {
        // Nápis se musí vejít do rámu celý. U okrajových částí — Pařezovice,
        // Rychtářov — by jinak vyčuhoval ven a zůstalo by z něj „ařezovice".
        const dx = Math.min(
          sirkaPx - 4 - m.w / 2 - m.x,
          Math.max(4 + m.w / 2 - m.x, dxKam),
        );
        const dy = Math.min(
          vyskaPx - 4 - m.h / 2 - m.y,
          Math.max(4 + m.h / 2 - m.y, dyKam),
        );
        const ram = {
          x1: m.x + dx - m.w / 2 - 2,
          y1: m.y + dy - m.h / 2 - 1,
          x2: m.x + dx + m.w / 2 + 2,
          y2: m.y + dy + m.h / 2 + 1,
        };
        if (volno(ram)) {
          usadil = { dx, dy, ram };
          break;
        }
      }
      if (!usadil) {
        m.prvek.hidden = true;
        continue;
      }
      m.prvek.style.transform =
        'translate(-50%, -50%) translate(' + usadil.dx + 'px, ' + usadil.dy + 'px)';
      zabrane.push(usadil.ram);
    }
  }

  /** Přiblíží tak, aby bod pod kurzorem zůstal na místě. */
  function zoomKolem(nasobek, sx, sy) {
    uzHnul = true;
    const r = mapa.getBoundingClientRect();
    const px = sx ?? r.width / 2;
    const py = sy ?? r.height / 2;
    const h = pohled.w * pomer();
    const mx = pohled.x + (px / r.width) * pohled.w;
    const my = pohled.y + (py / r.height) * h;

    const nova = Math.min(nejvetsiSirka(), Math.max(NEJMENSI_SIRKA, pohled.w / nasobek));
    pohled.x = mx - (px / r.width) * nova;
    pohled.y = my - (py / r.height) * nova * pomer();
    pohled.w = nova;
    vykresli();
  }

  function priblizNaBod(mx, my, sirkaVyrezu) {
    pohled.w = Math.min(nejvetsiSirka(), Math.max(NEJMENSI_SIRKA, sirkaVyrezu));
    pohled.x = mx - pohled.w / 2;
    pohled.y = my - (pohled.w * pomer()) / 2;
    vykresli();
  }

  /**
   * Výchozí pohled: celá obec. Kdo bydlí v Rychtářově nebo na Hamiltonech,
   * musí svou čtvrť vidět hned — přiblížit si ji umí každý sám, ale hledat
   * ji posouváním po výřezu, ve kterém není, je otrava.
   */
  function naCelek() {
    pohled.w = nejvetsiSirka();
    pohled.x = STRED_X - pohled.w / 2;
    pohled.y = STRED_Y - (pohled.w * pomer()) / 2;
  }

  /** Nastaví výřez tak, aby se do něj vešly oba body i s okrajem. */
  function obemkni(x1, y1, x2, y2) {
    const okraj = 80;
    const sirka = Math.abs(x2 - x1) + okraj * 2;
    // Výška se přepočítá na šířku, protože výřez má pevný poměr stran.
    const zVysky = (Math.abs(y2 - y1) + okraj * 2) / pomer();
    priblizNaBod((x1 + x2) / 2, (y1 + y2) / 2, Math.max(sirka, zVysky, NEJMENSI_SIRKA));
  }

  /* ------------------------------------------------------------------ *
   *  Výběr budovy                                                       *
   * ------------------------------------------------------------------ */

  function popisBudovy(b) {
    return b.nazev + ', ' + b.adresa;
  }

  function ukazPopisCile(b) {
    if (!popisCile) return;
    popisCile.innerHTML = '';
    popisCile.append(document.createTextNode(b.nazev));
    const adresa = document.createElement('span');
    adresa.textContent = ', ' + b.adresa;
    popisCile.append(adresa);
    popisCile.dataset.mx = b.mx;
    popisCile.dataset.my = b.my;
    popisCile.hidden = false;
  }

  function ukazBudovu(index, vlastniAdresa) {
    const b = budovy[index];
    if (!b) return;

    for (const g of mapa.querySelectorAll('.budova-plocha')) {
      g.toggleAttribute('data-vybrany', Number(g.dataset.budova) === index);
    }
    for (const p of mapa.querySelectorAll('.budova-pin')) {
      p.toggleAttribute('data-vybrany', Number(p.dataset.pinBudova) === index);
    }

    karta.toggleAttribute('data-vybrano', true);
    vyzva.hidden = true;
    kartaObsah.hidden = false;
    kartaObsah.innerHTML = '';

    const nadtitulek = document.createElement('p');
    nadtitulek.className = 'karta-nadtitulek';
    nadtitulek.textContent = 'Volební místnost';
    kartaObsah.append(nadtitulek);

    const misto = document.createElement('p');
    misto.className = 'karta-misto';
    misto.append(document.createTextNode(b.nazev));
    const adresa = document.createElement('span');
    adresa.textContent = ', ' + b.adresa;
    misto.append(adresa);
    kartaObsah.append(misto);

    if (b.bezbarierovy) {
      const bez = document.createElement('p');
      bez.className = 'karta-doplnek';
      bez.textContent = '♿ Bezbariérový přístup';
      kartaObsah.append(bez);
    }

    if (vlastniAdresa) {
      const vase = document.createElement('p');
      vase.className = 'karta-vase';
      vase.textContent = 'Pro adresu ' + vlastniAdresa;
      kartaObsah.append(vase);
    }

    ukazPopisCile(b);
  }

  function zrusVyber() {
    for (const g of mapa.querySelectorAll('.budova-plocha')) g.removeAttribute('data-vybrany');
    for (const p of mapa.querySelectorAll('.budova-pin')) p.removeAttribute('data-vybrany');
    karta.removeAttribute('data-vybrano');
    vyzva.hidden = false;
    kartaObsah.hidden = true;
    if (moje) {
      moje.hidden = true;
      delete moje.dataset.vzdyVidet;
    }
    if (popisAdresyPrvek) {
      popisAdresyPrvek.hidden = true;
      delete popisAdresyPrvek.dataset.vzdyVidet;
    }
    if (popisCile) {
      popisCile.hidden = true;
      delete popisCile.dataset.vzdyVidet;
    }
    if (spojnice) spojnice.setAttribute('d', '');
  }

  /* ------------------------------------------------------------------ *
   *  Vyhledávání adresy                                                 *
   * ------------------------------------------------------------------ */

  if (oddil && vstup) {
    oddil.hidden = false;

    let adresy = null;
    let nacitam = null;
    let vybrany = -1;
    let aktualni = [];

    async function zajistiData() {
      if (adresy) return adresy;
      if (!nacitam) {
        stav.textContent = 'Načítám seznam adres…';
        nacitam = fetch(cestaKDatum)
          .then((o) => {
            if (!o.ok) throw new Error(String(o.status));
            return o.json();
          })
          .then((d) => {
            adresy = d.adresy.map((a) => ({
              ulice: d.ulice[a[0]],
              co: a[1],
              cp: a[2],
              budova: d.okrsekNaBudovu[a[3]],
              lat: a[4],
              lon: a[5],
              cast: d.casti[a[6]],
              uliceKlic: zjednodus(d.ulice[a[0]]),
            }));
            stav.textContent = '';
            return adresy;
          })
          .catch(() => {
            stav.textContent = 'Seznam adres se nepodařilo načíst. Zkuste to prosím znovu.';
            nacitam = null;
            return null;
          });
      }
      return nacitam;
    }

    /**
     * Rozebere, co člověk napsal, na ulici a číslo.
     *
     * Musí zvládnout „Dukelská 12", „dukelska12", „Dukelská 12/345"
     * i „Dukelská 345/12" — někdo zná svůj dům podle orientačního čísla,
     * někdo podle popisného a pořadí si nikdo nepamatuje.
     */
    function rozeber(text) {
      const t = zjednodus(text).replace(/[,;]/g, ' ');
      const shoda = t.match(/^(.*?[a-z])\s*(\d+[a-z]?)(?:\s*\/\s*(\d+[a-z]?))?\s*$/);
      if (shoda) return { ulice: shoda[1].trim(), cisla: [shoda[2], shoda[3]].filter(Boolean) };
      return { ulice: t.trim(), cisla: [] };
    }

    function hodnoceni(a, ulice, cisla) {
      const zacina = a.uliceKlic.startsWith(ulice);
      if (!zacina && !a.uliceKlic.includes(ulice)) return -1;
      const body = zacina ? 100 : 50;
      if (!cisla.length) return body;
      const co = zjednodus(a.co);
      const cp = zjednodus(a.cp);
      const sedi = cisla.filter((c) => c === co || c === cp).length;
      if (!sedi) return -1;
      // Shoda na obou číslech je jistota, shoda na orientačním má přednost.
      return body + sedi * 100 + (cisla.some((c) => c === co) ? 10 : 0);
    }

    function popisAdresy(a) {
      const cisla = a.co && a.cp ? a.co + '/' + a.cp : a.co || a.cp;
      return a.ulice + ' ' + cisla;
    }

    function vykresliNavrhy(seznam) {
      navrhy.innerHTML = '';
      aktualni = seznam;
      vybrany = -1;
      if (!seznam.length) {
        navrhy.hidden = true;
        vstup.setAttribute('aria-expanded', 'false');
        return;
      }
      seznam.forEach((a, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = 'navrh-' + i;
        li.append(document.createTextNode(popisAdresy(a)));
        const cast = document.createElement('span');
        cast.className = 'navrh-cast';
        cast.textContent = ', ' + a.cast;
        li.append(cast);
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          vyber(i);
        });
        navrhy.append(li);
      });
      navrhy.hidden = false;
      vstup.setAttribute('aria-expanded', 'true');
    }

    function vyber(i) {
      const a = aktualni[i];
      if (!a) return;
      vstup.value = popisAdresy(a);
      navrhy.hidden = true;
      vstup.setAttribute('aria-expanded', 'false');

      ukazBudovu(a.budova, popisAdresy(a) + ', ' + a.cast);

      const b = naMapu(a.lat, a.lon);
      const cil = budovy[a.budova];

      moje.dataset.mx = b.mx;
      moje.dataset.my = b.my;
      moje.dataset.vzdyVidet = '1';
      moje.hidden = false;

      // Do mapy se vypíše obojí: kde člověk bydlí a kam má jít.
      if (popisAdresyPrvek) {
        popisAdresyPrvek.textContent = popisAdresy(a);
        popisAdresyPrvek.dataset.mx = b.mx;
        popisAdresyPrvek.dataset.my = b.my;
        popisAdresyPrvek.dataset.vzdyVidet = '1';
        popisAdresyPrvek.hidden = false;
      }
      if (cil) {
        if (popisCile) popisCile.dataset.vzdyVidet = '1';
        if (spojnice) spojnice.setAttribute('d', `M${b.mx},${b.my}L${cil.mx},${cil.my}`);
        obemkni(b.mx, b.my, cil.mx, cil.my);
      } else {
        priblizNaBod(b.mx, b.my, vyrez.sirka / 5);
      }
    }

    async function hledej() {
      smazat.hidden = !vstup.value;
      const { ulice, cisla } = rozeber(vstup.value);
      if (ulice.length < 2) {
        vykresliNavrhy([]);
        return;
      }
      const vsechny = await zajistiData();
      if (!vsechny) return;

      const nalez = vsechny
        .map((a) => ({ a, skore: hodnoceni(a, ulice, cisla) }))
        .filter((z) => z.skore >= 0)
        .sort((p, q) => q.skore - p.skore)
        .slice(0, 12)
        .map((z) => z.a);

      vykresliNavrhy(nalez);
      stav.textContent = nalez.length ? '' : 'Takovou adresu ve Vyškově nenacházím.';
    }

    vstup.addEventListener('input', hledej);
    vstup.addEventListener('focus', hledej);

    vstup.addEventListener('keydown', (e) => {
      if (navrhy.hidden) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        vybrany = (vybrany + (e.key === 'ArrowDown' ? 1 : -1) + aktualni.length) % aktualni.length;
        for (const [i, li] of [...navrhy.children].entries()) {
          li.toggleAttribute('data-vybrany', i === vybrany);
        }
        vstup.setAttribute('aria-activedescendant', 'navrh-' + vybrany);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        vyber(vybrany >= 0 ? vybrany : 0);
      } else if (e.key === 'Escape') {
        navrhy.hidden = true;
        vstup.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (e) => {
      if (!oddil.contains(e.target)) {
        navrhy.hidden = true;
        vstup.setAttribute('aria-expanded', 'false');
      }
    });

    smazat.addEventListener('click', () => {
      vstup.value = '';
      smazat.hidden = true;
      navrhy.hidden = true;
      stav.textContent = '';
      zrusVyber();
      vstup.focus();
    });

    oddil.addEventListener('submit', (e) => e.preventDefault());
  }

  /* ------------------------------------------------------------------ *
   *  Ovládání mapy                                                      *
   * ------------------------------------------------------------------ */

  if (mapa && svg && ovladani) {
    ovladani.hidden = false;

    ovladani.addEventListener('click', (e) => {
      const tlacitko = e.target.closest('[data-zoom]');
      if (!tlacitko) return;
      const co = tlacitko.dataset.zoom;
      if (co === 'dovnitr') zoomKolem(1.6);
      else if (co === 'ven') zoomKolem(1 / 1.6);
      else {
        naCelek();
        vykresli();
      }
    });

    // Kolečko přibližuje přímo, bez držení Ctrl — na mapě to lidé čekají.
    mapa.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const r = mapa.getBoundingClientRect();
        zoomKolem(Math.pow(1.0018, -e.deltaY), e.clientX - r.left, e.clientY - r.top);
      },
      { passive: false },
    );

    const prsty = new Map();
    let tazeniZ = null;
    let stipnutiZ = null;
    let taholJsem = false;
    // Oblast pod prstem si pamatujeme už od stisku. Během tažení totiž mapa
    // ukazatel zachytí (setPointerCapture) a následný `click` už nemíří
    // do plochy, ale na celý rám mapy — kliknutí by pak nedělalo nic.
    let budovaPodStiskem = null;

    const rozestup = () => {
      const b = [...prsty.values()];
      return Math.hypot(b[0].x - b[1].x, b[0].y - b[1].y);
    };
    const stred = () => {
      const b = [...prsty.values()];
      return { x: (b[0].x + b[1].x) / 2, y: (b[0].y + b[1].y) / 2 };
    };

    mapa.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.mapa-ovladani')) return;
      const r = mapa.getBoundingClientRect();
      prsty.set(e.pointerId, { x: e.clientX - r.left, y: e.clientY - r.top });
      mapa.setPointerCapture(e.pointerId);
      taholJsem = false;
      const plocha = e.target.closest('.budova-plocha');
      budovaPodStiskem = plocha ? Number(plocha.dataset.budova) : null;

      if (prsty.size === 1) {
        const p = prsty.get(e.pointerId);
        tazeniZ = { x: p.x, y: p.y, pohledX: pohled.x, pohledY: pohled.y, sirka: r.width };
      } else if (prsty.size === 2) {
        tazeniZ = null;
        stipnutiZ = { vzdalenost: rozestup(), sirka: pohled.w };
      }
    });

    mapa.addEventListener('pointermove', (e) => {
      if (!prsty.has(e.pointerId)) return;
      const r = mapa.getBoundingClientRect();
      prsty.set(e.pointerId, { x: e.clientX - r.left, y: e.clientY - r.top });

      if (prsty.size === 2 && stipnutiZ && stipnutiZ.vzdalenost > 0) {
        const s = stred();
        // Přepočet vůči stavu na začátku štípnutí, ne krok po kroku —
        // jinak se chyby sčítají a přiblížení „ujíždí".
        const cilovaSirka = stipnutiZ.sirka / (rozestup() / stipnutiZ.vzdalenost);
        zoomKolem(pohled.w / cilovaSirka, s.x, s.y);
        taholJsem = true;
        return;
      }

      if (tazeniZ) {
        const p = prsty.get(e.pointerId);
        if (Math.hypot(p.x - tazeniZ.x, p.y - tazeniZ.y) > 4) {
          taholJsem = true;
          mapa.toggleAttribute('data-taham', true);
        }
        // Posun v pixelech se převádí na jednotky mapy podle aktuálního výřezu.
        const naJednotky = pohled.w / tazeniZ.sirka;
        pohled.x = tazeniZ.pohledX - (p.x - tazeniZ.x) * naJednotky;
        pohled.y = tazeniZ.pohledY - (p.y - tazeniZ.y) * naJednotky;
        vykresli();
      }
    });

    const pustil = (e) => {
      const posledni = prsty.size === 1;
      prsty.delete(e.pointerId);
      if (prsty.size < 2) stipnutiZ = null;
      if (prsty.size === 0) {
        tazeniZ = null;
        mapa.toggleAttribute('data-taham', false);
      }

      // Výběr až při puštění, a jen když se mapa mezitím netahala — jinak by
      // posunutí mapy náhodně přepnulo oblast.
      if (e.type === 'pointerup' && posledni && !taholJsem && budovaPodStiskem != null) {
        ukazBudovu(budovaPodStiskem);
        // Popisek cíle dostal souřadnice až teď — bez přepočtu by zůstal
        // na staré (nebo žádné) pozici, useknutý u okraje mapy.
        vykresli();
        // Popisek adresy a spojnice patří jen k vyhledané adrese.
        if (moje) {
          moje.hidden = true;
          delete moje.dataset.vzdyVidet;
        }
        if (popisAdresyPrvek) popisAdresyPrvek.hidden = true;
        if (spojnice) spojnice.setAttribute('d', '');
        if (popisCile) delete popisCile.dataset.vzdyVidet;
        if (vstup) vstup.value = '';
        if (smazat) smazat.hidden = true;
      }
      budovaPodStiskem = null;
    };
    mapa.addEventListener('pointerup', pustil);
    mapa.addEventListener('pointercancel', pustil);

    window.addEventListener('resize', vykresli);
    naCelek();
    vykresli();
  }
</script>
