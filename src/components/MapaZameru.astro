---
/**
 * Mapa záměrů — co a kde chceme ve Vyškově udělat.
 *
 * Stojí na společném podkladu všech map webu (`src/lib/mapa-zaklad.ts`):
 * stejné dlaždice, stejný styl, stejné chování jako mapa volebních okrsků
 * i mapa na stánku. Dlaždice leží v repozitáři, takže web při zobrazení
 * neposílá jediný požadavek ven a nikdo návštěvníky nesleduje.
 *
 * Detail se rozbaluje v seznamu vedle mapy, ne v překryvném okně.
 */

import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { BARVA_TEMATU, temaDoAdresy } from '../lib/temata';
import type { Tema } from '../lib/temata';
import pokryti from '../lib/mapa-dlazdice.json';
import nahledMapy from '../assets/nahled-mapa-zameru.png';
import '../styles/mapa.css';

// Pořadí i čísla na odznacích vycházejí z názvů souborů. V datech žádné
// číslo není — jinak by se při každém přidání bodu muselo přečíslovat vše.
const zamery = (await getCollection('zamery'))
  .sort((a, b) => a.id.localeCompare(b.id, 'cs'))
  .map((zamer, i) => ({ ...zamer, cislo: i + 1 }));

// Bod mimo výřez by se vykreslil někde za okrajem mapy, kam se posunout nedá,
// takže by ho nikdo neuviděl. Radši o tom hlasitě řekneme při sestavení, než
// aby zmizel potichu.
const mimoMapu = zamery.filter(
  (z) =>
    z.data.lat < pokryti.jih ||
    z.data.lat > pokryti.sever ||
    z.data.lon < pokryti.zapad ||
    z.data.lon > pokryti.vychod,
);
if (mimoMapu.length) {
  throw new Error(
    'Tyhle záměry leží mimo staženou mapu a nebylo by je vidět: ' +
      mimoMapu.map((z) => `${z.data.nazev} (${z.data.lat}, ${z.data.lon})`).join(', ') +
      '. Buď opravte souřadnice, nebo rozšiřte výřez v nastroje/dlazdice.mjs.',
  );
}

const sObsahem = await Promise.all(
  zamery.map(async (zamer) => ({ ...zamer, Obsah: (await render(zamer)).Content })),
);

/** Nabízí se jen to, co je na mapě skutečně zastoupené. */
const pouziteTemata = [...new Set(zamery.map((z) => z.data.tema))] as Tema[];

const jsouNavrhy = zamery.some((z) => z.data.stav === 'navrh');
---

<section class="mapa-sekce pas-noc" id="zamery">
  <div class="pruh">
    <p class="nadtitulek">Mapa záměrů</p>
    <h2 class="mapa-nadpis">Program není seznam přání. Jsou to&nbsp;místa, která denně míjíte.</h2>
    <p class="perex mapa-perex">
      Každý bod je konkrétní místo ve Vyškově a konkrétní věc, kterou tam chceme udělat.
      Klikněte na bod v mapě nebo na položku v seznamu.
    </p>

    {
      jsouNavrhy && (
        <p class="mapa-vystraha">
          <strong>Pracovní verze.</strong> Body označené „návrh" jsou podklad k diskuzi —
          polohy jsou skutečné, texty čekají na potvrzení týmem.
        </p>
      )
    }

    {/* Filtry jsou skryté a odkrývá je až skript — bez JavaScriptu by to byla
        mrtvá tlačítka. Seznam pod mapou zůstane čitelný tak jako tak. */}
    <div class="mapa-filtry" data-mapa-filtry hidden>
      <button type="button" class="filtr je-aktivni" data-tema="">Vše</button>
      {
        pouziteTemata.map((tema) => (
          <button
            type="button"
            class="filtr"
            data-tema={temaDoAdresy(tema)}
            style={`--barva: ${BARVA_TEMATU[tema]}`}
          >
            {tema}
          </button>
        ))
      }
    </div>

    <div class="mapa-rozvrzeni">
      <div class="mapa-obal">
        <div class="mapa-plocha" data-mapa>
          <div class="mapa-platno" data-mapa-platno></div>

          {/* Odznaky vykresluje šablona, ne skript — jsou to skutečná tlačítka
              s popiskem pro čtečku obrazovky. Skript je jen předá mapě, která
              si je pak drží na svém místě.

              Obal kolem tlačítka nutný je: mapa značce nastavuje `transform`,
              kterým ji drží na místě, a zvětšení odznaku při najetí by jí ho
              přepsalo — odznak by odskočil do rohu mapy. */}
          <div class="mapa-znacky" data-mapa-znacky hidden>
            {
              zamery.map((zamer) => (
                <span
                  class="mapa-znacka"
                  data-bod={zamer.cislo}
                  data-lat={zamer.data.lat}
                  data-lon={zamer.data.lon}
                >
                  <button
                    type="button"
                    class="mapa-bod"
                    data-bod={zamer.cislo}
                    data-tema={temaDoAdresy(zamer.data.tema)}
                    style={`--barva: ${BARVA_TEMATU[zamer.data.tema]}`}
                    aria-label={`${zamer.cislo}. ${zamer.data.nazev}`}
                  >
                    <span aria-hidden="true">{zamer.cislo}</span>
                  </button>
                </span>
              ))
            }
          </div>

          {/* Ovládání je v HTML skryté a odkrývá ho až skript — bez JavaScriptu
              tu žádná mapa není a mrtvá tlačítka nechceme. */}
          <div class="mapa-ovladani" data-mapa-ovladani hidden>
            <button type="button" data-zoom="ven" aria-label="Oddálit mapu">−</button>
            <button type="button" data-zoom="dovnitr" aria-label="Přiblížit mapu">+</button>
            <button type="button" data-zoom="reset" aria-label="Zobrazit všechny záměry">
              Celé město
            </button>
          </div>

          <noscript>
            <Image src={nahledMapy} alt="Mapa Vyškova s vyznačenými záměry" class="mapa-nahrada" />
            <p class="mapa-bez-js">
              Mapa se ovládá skriptem, který je vypnutý. Všechny záměry i s popisem najdete
              v seznamu níž.
            </p>
          </noscript>
        </div>
      </div>


      <ol class="mapa-seznam" data-mapa-seznam>
        {
          sObsahem.map((zamer) => (
            <li
              class="zamer"
              data-polozka={zamer.cislo}
              data-tema={temaDoAdresy(zamer.data.tema)}
            >
              <details>
                <summary>
                  <span class="zamer-cislo" style={`--barva: ${BARVA_TEMATU[zamer.data.tema]}`}>
                    {zamer.cislo}
                  </span>
                  <span class="zamer-hlava">
                    <span class="zamer-nazev">{zamer.data.nazev}</span>
                    <span class="zamer-stitky">
                      <span class="zamer-tema" style={`--barva: ${BARVA_TEMATU[zamer.data.tema]}`}>
                        {zamer.data.tema}
                      </span>
                      {zamer.data.stav === 'navrh' && <span class="zamer-navrh">návrh</span>}
                    </span>
                  </span>
                </summary>
                <div class="zamer-text">
                  <zamer.Obsah />
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Sekce si nese vlastní odsazení, protože ji stránka vkládá hned pod
     hlavičku — bez tohohle by nadtitulek lepil na logo. */
  .mapa-sekce {
    padding-block: var(--mezera-sekce);
  }

  .mapa-nadpis {
    max-width: 22ch;
  }

  .mapa-perex {
    margin-top: 0.9rem;
  }

  .mapa-vystraha {
    max-width: var(--sirka-textu);
    margin: 1.25rem 0 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--navrh);
    border-radius: 0 var(--radius-maly) var(--radius-maly) 0;
    background: rgb(160 90 0 / 0.18);
    font-size: var(--text-maly);
    color: var(--na-noci);
  }

  /* ---------- Filtry ---------- */

  .mapa-filtry {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .mapa-filtry[hidden] {
    display: none;
  }

  .mapa-filtry .filtr {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: 999px;
    background: transparent;
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-drobny);
    font-weight: 500;
    cursor: pointer;
    transition: background var(--prechod), border-color var(--prechod);
  }

  .mapa-filtry .filtr:hover {
    border-color: var(--na-noci-tlum);
    background: var(--noc-svetlejsi);
  }

  .mapa-filtry .filtr.je-aktivni {
    background: var(--barva, var(--modra));
    border-color: var(--barva, var(--modra));
    color: #fff;
  }

  /* ---------- Rozvržení ---------- */

  .mapa-rozvrzeni {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
  }

  @media (min-width: 900px) {
    .mapa-rozvrzeni {
      grid-template-columns: 1.55fr 1fr;
      align-items: start;
    }
    /* Mapa zůstane na očích, i když člověk projíždí seznam. */
    .mapa-obal {
      position: sticky;
      top: 5.5rem;
    }
  }

  .mapa-plocha {
    position: relative;
    /* Na šířku mobilu by z mapy v tomhle poměru zbyl proužek 280 bodů vysoký
       a odznaky by se v něm slepily. Proto je na úzkém displeji na výšku. */
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--noc);
    border: 1px solid var(--linka-na-noci);
  }

  /* Mapa vyplní rám. Bez zadané výšky by si ji knihovna spočítala jako
     nulovou a z mapy by zbyl proužek. */
  .mapa-platno {
    position: absolute;
    inset: 0;
  }

  /* ---------- Ovládání zvětšení ---------- */

  .mapa-ovladani {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: flex;
    gap: 0.35rem;
    z-index: 3;
  }

  .mapa-ovladani[hidden] {
    display: none;
  }

  .mapa-ovladani button {
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding-inline: 0.6rem;
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius-maly);
    background: var(--mapa-lista);
    color: var(--na-noci);
    font: inherit;
    font-size: var(--text-maly);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background var(--prechod), border-color var(--prechod);
  }

  .mapa-ovladani button:hover:not(:disabled) {
    background: var(--noc-svetlejsi);
    border-color: var(--na-noci-tlum);
  }

  .mapa-ovladani button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .mapa-ovladani [data-zoom='reset'] {
    font-size: var(--text-drobny);
  }

  /* ---------- Bez JavaScriptu ----------
     Mapa je vektorová a bez skriptu se nevykreslí. Místo prázdného rámu se
     ukáže obrázek téže mapy — a hlavně věta, že všechny záměry i s popisem
     jsou v seznamu pod ní, takže o nic nepřijde. */

  .mapa-nahrada {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mapa-bez-js {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: var(--mapa-lista);
    color: var(--na-noci);
    font-size: var(--text-drobny);
  }


  /* ---------- Body ---------- */

  /* Obal, kterému mapa nastavuje polohu. Sám nesmí mít žádný vlastní
     `transform` — přepsal by ten, kterým si ho mapa drží na místě. */
  .mapa-znacka {
    display: block;
    line-height: 0;
  }

  /* Pořadí vykreslení se musí řídit ODSUD, ne z odznaku uvnitř.
     Mapa dává každé značce vlastní umístění právě na tenhle obal, takže
     `z-index` na odznaku pod ním rozhoduje jen o vrstvách uvnitř jedné
     značky — mezi značkami navzájem neznamená nic. Vybraný bod se proto
     schovával pod sousedy, kteří jsou v HTML za ním, a protože ti zároveň
     ustupují do 40 % průhlednosti, prosvítal skrz ně a vypadal vybledle.
     Je to vidět jen tam, kde se odznaky překrývají — tedy v centru. */
  .mapa-znacka.je-vybrana {
    z-index: 3;
  }

  .mapa-znacka:has(.mapa-bod:hover) {
    z-index: 2;
  }

  .mapa-znacky[hidden] {
    display: none;
  }

  .mapa-bod {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 2px solid rgb(255 255 255 / 0.85);
    border-radius: 999px;
    background: var(--barva, var(--modra));
    color: #fff;
    font: inherit;
    font-size: var(--text-drobny);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.45);
    /* Odznak leží nad mapou, ne v ní, takže se s přiblížením nezvětšuje
       sám — zvětší se jen pod kurzorem a u zvýrazněné položky. */
    transform: scale(var(--zvetseni, 1));
    transition:
      transform var(--prechod),
      opacity var(--prechod),
      border-color var(--prechod),
      box-shadow var(--prechod);
  }

  .mapa-bod:hover {
    --zvetseni: 1.28;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.6);
  }

  /* Vybraný bod musí být poznat na první pohled. Samotné zvětšení nestačí —
     v hromadě stejně velkých koleček se ztratí, tak k němu přibyl světlý
     prstenec a ostatní body ustoupí. */
  .mapa-bod.je-zvyrazneny {
    --zvetseni: 1.5;
    border-color: #fff;
    box-shadow:
      0 0 0 4px rgb(255 255 255 / 0.4),
      0 6px 20px rgb(0 0 0 / 0.7);
  }

  /* `:not([data-skryty])` tu musí být: odfiltrovaný bod má ustupovat víc
     (0.12) a bez té výjimky by ho tohle pravidlo kvůli vyšší specifičnosti
     přebilo a zase ho zviditelnilo. */
  .mapa-plocha[data-zvyraznuji] .mapa-bod:not(.je-zvyrazneny):not([data-skryty]) {
    opacity: 0.4;
  }

  .mapa-bod[data-skryty] {
    opacity: 0.12;
    pointer-events: none;
  }

  @media (min-width: 620px) {
    .mapa-plocha {
      aspect-ratio: 1000 / 717;
    }
  }

  @media (max-width: 560px) {
    .mapa-bod {
      width: 1.7rem;
      height: 1.7rem;
    }
  }

  /* ---------- Seznam ---------- */

  .mapa-seznam {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .zamer[data-skryty] {
    display: none;
  }

  .zamer details {
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--linka-na-noci);
    border-radius: var(--radius-maly);
    transition: border-color var(--prechod), background var(--prechod);
  }

  .zamer details[open],
  .zamer.je-zvyrazneny details {
    border-color: var(--na-noci-tlum);
    background: rgb(255 255 255 / 0.07);
  }

  .zamer summary {
    display: flex;
    align-items: start;
    gap: 0.7rem;
    padding: 0.7rem 0.85rem;
    cursor: pointer;
    list-style: none;
  }

  .zamer summary::-webkit-details-marker {
    display: none;
  }

  .zamer-cislo {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    background: var(--barva, var(--modra));
    color: #fff;
    font-size: var(--text-drobny);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .zamer-hlava {
    display: grid;
    gap: 0.3rem;
  }

  .zamer-nazev {
    font-size: var(--text-maly);
    font-weight: 600;
    line-height: 1.35;
  }

  .zamer-stitky {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .zamer-tema {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--barva) 26%, transparent);
    color: var(--na-noci);
    font-size: var(--text-drobny);
  }

  .zamer-navrh {
    padding: 0.1rem 0.5rem;
    border: 1px dashed var(--navrh);
    border-radius: 999px;
    color: #e0a45c;
    font-size: var(--text-drobny);
  }

  .zamer-text {
    padding: 0 0.85rem 0.85rem 3.15rem;
    font-size: var(--text-maly);
    color: var(--na-noci-tlum);
  }

  @media (max-width: 560px) {
    .zamer-text {
      padding-left: 0.85rem;
    }
  }
</style>

<script>
  import maplibre from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { vytvorMapu, hraniceBodu } from '../lib/mapa-zaklad';

  const mapa = document.querySelector<HTMLElement>('[data-mapa]');
  const seznam = document.querySelector<HTMLElement>('[data-mapa-seznam]');
  const filtry = document.querySelector<HTMLElement>('[data-mapa-filtry]');

  if (mapa && seznam) {
    const body = [...mapa.querySelectorAll<HTMLButtonElement>('.mapa-bod')];
    const polozky = [...seznam.querySelectorAll<HTMLElement>('.zamer')];

    /**
     * Doveze mapu k záměru. Naplní se až níž, při zakládání mapy.
     *
     * Výběr záměru totiž funguje i dřív, než se mapa stihne postavit —
     * seznam je obyčejné HTML a člověk do něj může kliknout hned.
     */
    let privez: (poradi: string) => void = () => {};

    const polozkaPodle = (poradi: string) => polozky.find((p) => p.dataset.polozka === poradi);

    /**
     * Vybraný záměr. Drží se zvlášť od najetí myší, protože po kliknutí do
     * mapy se odroluje na položku v seznamu — mapa se přitom pohne pod
     * kurzorem, kurzor bod opustí a `mouseleave` by výběr hned zhasl.
     * Najetí se tedy jen dočasně přiloží a při odjetí se vrátí to vybrané.
     */
    let vybrany: string | null = null;

    /** Zvýrazní dvojici bod + položka. Volá se z obou stran. */
    function zvyraznit(poradi: string | null) {
      for (const b of body) {
        const vybrany = b.dataset.bod === poradi;
        b.classList.toggle('je-zvyrazneny', vybrany);
        // Vytažení dopředu patří na obal značky, ne na odznak — proč, viz
        // komentář u `.mapa-znacka.je-vybrana` ve stylech.
        b.closest('.mapa-znacka')?.classList.toggle('je-vybrana', vybrany);
      }
      for (const p of polozky) p.classList.toggle('je-zvyrazneny', p.dataset.polozka === poradi);
      // Podle tohohle příznaku CSS utlumí ostatní body. Kdyby se ustupovalo
      // pořád, mapa by vypadala vybledle i bez vybraného bodu.
      mapa!.toggleAttribute('data-zvyraznuji', poradi !== null);
    }

    /** Vybere záměr natrvalo — dokud si člověk nevybere jiný. */
    function vybrat(poradi: string | null) {
      vybrany = poradi;
      zvyraznit(poradi);
      if (poradi) privez(poradi);
    }

    // --- Klik na bod v mapě rozbalí položku v seznamu ----------------------
    for (const bod of body) {
      bod.addEventListener('click', () => {
        const poradi = bod.dataset.bod!;
        const polozka = polozkaPodle(poradi);
        if (!polozka) return;

        // Ostatní se zavřou, ať je vždycky otevřený jen jeden záměr.
        for (const jina of polozky) {
          const detail = jina.querySelector('details');
          if (detail) detail.open = jina === polozka;
        }
        vybrat(poradi);
        polozka.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });

      bod.addEventListener('mouseenter', () => zvyraznit(bod.dataset.bod!));
      bod.addEventListener('mouseleave', () => zvyraznit(vybrany));
    }

    // --- Rozbalení v seznamu zvýrazní bod v mapě ---------------------------
    for (const polozka of polozky) {
      const detail = polozka.querySelector('details');

      detail?.addEventListener('toggle', () => {
        if (!detail.open) return;
        for (const jina of polozky) {
          const jiny = jina.querySelector('details');
          if (jiny && jina !== polozka) jiny.open = false;
        }
        vybrat(polozka.dataset.polozka!);
      });

      polozka.addEventListener('mouseenter', () => zvyraznit(polozka.dataset.polozka!));
      polozka.addEventListener('mouseleave', () => zvyraznit(vybrany));
    }

    // --- Mapa ---------------------------------------------------------------

    const platno = mapa.querySelector<HTMLElement>('[data-mapa-platno]');
    const znacky = mapa.querySelector<HTMLElement>('[data-mapa-znacky]');
    const ovladani = mapa.querySelector<HTMLElement>('[data-mapa-ovladani]');

    if (platno && znacky && ovladani) {
      const obaly = [...znacky.querySelectorAll<HTMLElement>('.mapa-znacka')];
      const polohy = obaly.map((o) => ({
        lat: Number(o.dataset.lat),
        lon: Number(o.dataset.lon),
      }));

      // Výchozí pohled je na všechny záměry. Kdyby se sem psala čísla ručně,
      // záměr přidaný na okraji města by ležel mimo obraz a nikdo by si toho
      // nevšiml.
      const HRANICE = hraniceBodu(polohy);
      // Odstup od okraje. Musí být větší než polovina odznaku, jinak by
      // krajní odznak rám překryl a číslo v něm bylo napůl useknuté.
      const ODSTUP = 64;

      const mapaGl = vytvorMapu({
        prvek: platno,
        stred: [(HRANICE[0][0] + HRANICE[1][0]) / 2, (HRANICE[0][1] + HRANICE[1][1]) / 2],
        zoom: 13,
        opatrneOvladani: true,
      });
      mapaGl.fitBounds(HRANICE, { padding: ODSTUP, animate: false });
      // Rám mapy může dostat konečný rozměr až po prvním vykreslení stránky.
      // Bez tohohle by pak výřez seděl na starou, menší plochu.
      mapaGl.once('load', () => mapaGl.fitBounds(HRANICE, { padding: ODSTUP, animate: false }));

      // Odznaky vykreslila šablona, takže jsou to skutečná tlačítka s popiskem
      // pro čtečku. Mapa je jen převezme a drží na místě — vyrábět je skriptem
      // by znamenalo psát HTML v JavaScriptu a o přístupnost se starat znovu.
      znacky.hidden = false;
      for (const [i, obal] of obaly.entries()) {
        new maplibre.Marker({ element: obal })
          .setLngLat([polohy[i].lon, polohy[i].lat])
          .addTo(mapaGl);
      }

      // --- Ovládání přiblížení ---
      ovladani.hidden = false;
      const tlacitko = (co: string) =>
        ovladani.querySelector<HTMLButtonElement>('[data-zoom="' + co + '"]')!;

      ovladani.addEventListener('click', (e) => {
        const co = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-zoom]')?.dataset
          .zoom;
        if (co === 'dovnitr') mapaGl.zoomIn();
        else if (co === 'ven') mapaGl.zoomOut();
        else if (co === 'reset') mapaGl.fitBounds(HRANICE, { padding: ODSTUP });
      });

      const stavTlacitek = () => {
        const z = mapaGl.getZoom();
        tlacitko('dovnitr').disabled = z >= mapaGl.getMaxZoom() - 0.01;
        tlacitko('ven').disabled = z <= mapaGl.getMinZoom() + 0.01;
      };
      mapaGl.on('zoom', stavTlacitek);
      stavTlacitek();

      /**
       * Doveze mapu k záměru, ale jen když leží mimo obraz.
       *
       * Posouvat mapou pokaždé by bylo protivné: kdo si ji sám nastavil na
       * svoje okolí, nechce, aby mu uhýbala při každém rozkliknutí položky.
       */
      privez = (poradi) => {
        const i = obaly.findIndex((o) => o.dataset.bod === poradi);
        if (i < 0) return;
        const kde: [number, number] = [polohy[i].lon, polohy[i].lat];
        const r = platno.getBoundingClientRect();
        const b = mapaGl.project(kde);
        const uvnitr =
          b.x > ODSTUP && b.y > ODSTUP && b.x < r.width - ODSTUP && b.y < r.height - ODSTUP;
        if (!uvnitr) mapaGl.easeTo({ center: kde, duration: 500 });
      };
    }


    // --- Filtry ------------------------------------------------------------
    if (filtry) {
      filtry.hidden = false;

      filtry.addEventListener('click', (e) => {
        const tlacitko = (e.target as HTMLElement).closest<HTMLButtonElement>('.filtr');
        if (!tlacitko) return;

        const tema = tlacitko.dataset.tema ?? '';
        for (const jine of filtry.querySelectorAll('.filtr')) {
          jine.classList.toggle('je-aktivni', jine === tlacitko);
        }

        for (const bod of body) {
          bod.toggleAttribute('data-skryty', !!tema && bod.dataset.tema !== tema);
        }
        for (const polozka of polozky) {
          const sedi = !tema || polozka.dataset.tema === tema;
          polozka.toggleAttribute('data-skryty', !sedi);
          if (!sedi) {
            const detail = polozka.querySelector('details');
            if (detail) detail.open = false;
          }
        }
        vybrat(null);
      });
    }
  }
</script>
