---
/**
 * Ikona programové oblasti.
 *
 * Je to výjimka z pravidla „jeden grafický motiv" (viz CLAUDE.md) a drží se
 * proto v jedné soustavě, aby to nebyla sbírka klipartů:
 *
 *   - všechny v mřížce 24 × 24,
 *   - kreslené tahem o šířce 1,75 v `currentColor` — barvu určuje ten,
 *     kdo ikonu použije, obvykle barvou oblasti z `BARVA_TEMATU`,
 *   - zakulacené konce a spoje, žádné výplně kromě jediné tečky,
 *   - geometricky jednoduché: co nejde poznat na 20 pixelech, tady nemá co
 *     dělat.
 *
 * Doprava je záměrně kolo, ne auto — program mluví o bezpečném pohybu
 * pěších a cyklistů, ne o průjezdnosti pro auta.
 *
 * Přidat oblast znamená přidat sem i ikonu. Když se zapomene, sestavení
 * spadne — je to lepší než tichá mezera na dlaždici.
 */

import type { Tema } from '../lib/temata';

interface Props {
  tema: Tema;
  class?: string;
}

const { tema, class: trida } = Astro.props;

/** Tvary v mřížce 24 × 24. `t` je tah, `v` výplň (jen tam, kde bez ní tvar nedrží). */
const TVARY: Record<Tema, { t: string[]; v?: string[] }> = {
  // Sloupce nad osou — výkaz, ne mince. Mince s pruhem se při malé
  // velikosti čte jako nějaký cizí symbol, tohle je jednoznačné.
  'Hospodaření': { t: ['M4.6 19.6h14.8', 'M8 19.6V12.4', 'M12 19.6V6.8', 'M16 19.6V10'] },
  // Dům: střecha a stěny, které na ni dosedají. Když stěny začínaly níž,
  // vypadalo to jako střecha levitující nad krabicí.
  'Bydlení': { t: ['M4 11.4 12 4.6 20 11.4', 'M6.4 11.6V19.8h11.2V11.6'] },
  // List se žilkou a kapka.
  'Zeleň a voda': { t: ['M14.6 4.6c4.4 3 4.4 9.4-.6 12-3 1.6-6.4.6-8-2 5.2-1 7.4-5.4 8.6-10', 'M7.4 19.4c1.4-3.6 3.6-6.6 6.6-8.8'] },
  // Kolo, ne auto — viz komentář výše.
  'Doprava': { t: ['M6.6 18.4a3.1 3.1 0 1 0 0-6.2a3.1 3.1 0 0 0 0 6.2', 'M17.4 18.4a3.1 3.1 0 1 0 0-6.2a3.1 3.1 0 0 0 0 6.2', 'M6.6 15.3 11 8.9h4.2l2.2 6.4', 'M9.4 8.9h3.4'] },
  // Otevřená kniha.
  'Školství': { t: ['M12 7.6v11', 'M12 7.6C10.4 6.2 8 5.6 4.6 5.8v10.8c3.4-.2 5.8.4 7.4 1.8 1.6-1.4 4-2 7.4-1.8V5.8c-3.4-.2-5.8.4-7.4 1.8'] },
  // Vstupenka — kultura je o akcích, na které se jde. Zářezy po stranách
  // musí být mělké: hluboké udělaly z tvaru mašli.
  'Kultura': { t: ['M4.6 9.8V7.4h14.8v2.4a2.2 2.2 0 0 0 0 4.4v2.4H4.6v-2.4a2.2 2.2 0 0 0 0-4.4', 'M12.6 10.2v1.5', 'M12.6 13.1v1.5'] },
  // Nákupní taška — drobná provozovna, ne montovna.
  'Podnikání': { t: ['M5.4 8.6h13.2l-1 11.4H6.4z', 'M9.2 8.6V6.9a2.8 2.8 0 0 1 5.6 0v1.7'] },
  // Štít.
  'Bezpečnost': { t: ['M12 4 19 6.4v5.2c0 4-2.8 6.8-7 8.4-4.2-1.6-7-4.4-7-8.4V6.4z'] },
};

const tvar = TVARY[tema];
if (!tvar) {
  throw new Error(
    `Oblast „${tema}" nemá ikonu. Doplňte ji do src/components/IkonaTematu.astro — ` +
      'jinak by na dlaždici zůstalo prázdno a nikdo by si toho nevšiml.',
  );
}
---

<svg
  class:list={['ikona-tematu', trida]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {tvar.t.map((d) => <path d={d} />)}
  {tvar.v?.map((d) => <path class="ikona-vypln" d={d} />)}
</svg>

<style>
  .ikona-tematu {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ikona-vypln {
    fill: currentColor;
    stroke: none;
  }
</style>
