---
/**
 * Hlavička — logo a navigace.
 *
 * Na širokém displeji jsou položky vypsané vedle sebe, na úzkém se sbalí
 * do rozbalovací nabídky. Jsou to **dva samostatné prvky**, ne jeden
 * přepínaný CSS — a je to schválně:
 *
 * Dřív tu byl jediný <details>, který se na širokém displeji odkrýval přes
 * `display: block !important`. Novější prohlížeče ale obsah <details> skrývají
 * přes `::details-content { content-visibility: hidden }`, na což `display`
 * nestačí — a navigace na počítači zmizela úplně. Dva prvky tenhle problém
 * nemají a fungují i bez JavaScriptu.
 */

import { odkaz } from '../lib/odkaz';

const POLOZKY = [
  { text: 'Program', cil: '/program/' },
  { text: 'Mapa', cil: '/mapa/' },
  { text: 'Kandidáti', cil: '/lide/' },
  { text: 'Jak volit', cil: '/jak-volit/' },
  { text: 'Kontakt', cil: '/kontakt/' },
];

// Zvýraznění právě otevřené stránky. Porovnává se bez ohledu na to,
// jestli adresa končí lomítkem.
const zdeCesta = Astro.url.pathname.replace(/\/+$/, '');
const jeAktivni = (cil: string) => zdeCesta.endsWith(cil.replace(/\/+$/, ''));
---

<header class="hlavicka">
  <div class="pruh hlavicka-vnitrek">
    {/* Logo je vektor, takže je ostré na jakémkoliv displeji a váží pár kilobajtů.
        Poměr stran 1672 : 373 je zapsaný natvrdo, aby se stránka při načítání
        neposunula. */}
    <a class="logo" href={odkaz('/')}>
      <img
        src={odkaz('/logo.svg')}
        alt="Transparentní Vyškov — úvodní stránka"
        width="1672"
        height="373"
        fetchpriority="high"
      />
    </a>

    {/* Široký displej: položky vedle sebe */}
    <nav class="nabidka-siroka" aria-label="Hlavní nabídka">
      <ul>
        {
          POLOZKY.map((polozka) => (
            <li>
              <a href={odkaz(polozka.cil)} aria-current={jeAktivni(polozka.cil) ? 'page' : undefined}>
                {polozka.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Úzký displej: rozbalovací nabídka */}
    <details class="nabidka-uzka">
      <summary>
        <span class="carky" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Nabídka</span>
      </summary>

      <nav aria-label="Hlavní nabídka">
        <ul>
          {
            POLOZKY.map((polozka) => (
              <li>
                <a href={odkaz(polozka.cil)} aria-current={jeAktivni(polozka.cil) ? 'page' : undefined}>
                  {polozka.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .hlavicka {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(241 245 248 / 0.86);
    border-bottom: 1px solid var(--linka);
    /* Rozostřený podklad — text pod hlavičkou prosvítá, ale neruší.
       Je to ten koncept vrstvení, jen v malém. */
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
  }

  .hlavicka-vnitrek {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }

  .logo {
    display: block;
    flex: none;
    line-height: 0;
  }

  .logo img {
    width: clamp(175px, 22vw, 235px);
    height: auto;
  }

  /* --- Společný vzhled odkazů --------------------------------------------- */

  .hlavicka ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hlavicka nav a {
    display: block;
    color: var(--inkoust);
    font-size: var(--text-maly);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--prechod), border-color var(--prechod), background var(--prechod);
  }

  /* --- Široký displej ------------------------------------------------------ */

  .nabidka-siroka ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 2rem);
  }

  .nabidka-siroka a {
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
  }

  .nabidka-siroka a:hover {
    color: var(--modra-text);
    border-bottom-color: var(--zelena);
  }

  .nabidka-siroka a[aria-current='page'] {
    color: var(--modra-text);
    border-bottom-color: var(--modra);
  }

  @media (max-width: 859px) {
    .nabidka-siroka {
      display: none;
    }
  }

  /* --- Úzký displej -------------------------------------------------------- */

  @media (min-width: 860px) {
    .nabidka-uzka {
      display: none;
    }
  }

  .nabidka-uzka {
    position: relative;
  }

  .nabidka-uzka > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--linka-vyrazna);
    border-radius: 999px;
    font-size: var(--text-maly);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .nabidka-uzka > summary::-webkit-details-marker {
    display: none;
  }

  .carky {
    display: grid;
    gap: 3px;
    width: 16px;
  }

  .carky span {
    display: block;
    height: 2px;
    background: var(--inkoust);
    border-radius: 1px;
    transition: transform var(--prechod), opacity var(--prechod);
  }

  .nabidka-uzka[open] .carky span:first-child {
    transform: translateY(5px) rotate(45deg);
  }

  .nabidka-uzka[open] .carky span:nth-child(2) {
    opacity: 0;
  }

  .nabidka-uzka[open] .carky span:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  .nabidka-uzka > nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    min-width: 12rem;
    padding: 0.5rem;
    background: var(--plocha);
    border: 1px solid var(--linka);
    border-radius: var(--radius);
    box-shadow: var(--stin-zvednuty);
  }

  .nabidka-uzka nav ul {
    display: grid;
  }

  .nabidka-uzka nav a {
    padding: 0.65rem 0.7rem;
    border-radius: var(--radius-maly);
  }

  .nabidka-uzka nav a:hover,
  .nabidka-uzka nav a[aria-current='page'] {
    background: var(--modra-jemna);
    color: var(--modra-text);
  }
</style>

<script>
  // Zavře rozbalenou nabídku po kliknutí mimo ni nebo po Escape.
  // Bez tohohle zůstane viset otevřená, což na dotyku otravuje.
  const nabidka = document.querySelector<HTMLDetailsElement>('.nabidka-uzka');

  if (nabidka) {
    document.addEventListener('click', (e) => {
      if (nabidka.open && !nabidka.contains(e.target as Node)) nabidka.open = false;
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nabidka.open) {
        nabidka.open = false;
        nabidka.querySelector('summary')?.focus();
      }
    });
  }
</script>
